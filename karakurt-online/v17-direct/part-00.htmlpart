  .joystick{width:98px!important;height:98px!important;bottom:calc(env(safe-area-inset-bottom) + 76px)!important;background:radial-gradient(circle,#27342d66 0 28%,#07100d99 31% 68%,#02040377 70%)!important;opacity:.82}.joystick-knob{left:31px!important;top:31px!important;width:36px!important;height:36px!important}
  .combat{width:136px!important;height:98px!important;bottom:calc(env(safe-area-inset-bottom) + 76px)!important}.combat #mr{width:62px!important;height:62px!important;font-size:17px!important}.combat #mz{right:68px!important;width:46px!important;height:46px!important}.combat #mf{right:44px!important;bottom:53px!important;width:42px!important;height:42px!important}.combat #mdodge{right:91px!important;bottom:52px!important;width:38px!important;height:38px!important;font-size:10px!important}
  .hotbar{height:calc(62px + env(safe-area-inset-bottom))!important;padding:6px 132px calc(6px + env(safe-area-inset-bottom)) 112px!important;background:linear-gradient(transparent,#030504b0 24%,#030504e8)!important;border-top:0!important}
  .slot{width:39px!important;height:44px!important;border-radius:9px!important;border-color:#5a513fbb!important;background:radial-gradient(circle at 50% 28%,#303a33cc,#060908cc 72%)!important}.slot .icon{font-size:15px!important}.slot small{font-size:5.5px!important}.slot kbd{font-size:6px!important}.slots{gap:3px!important}
  .sidebtns{top:auto!important;bottom:calc(env(safe-area-inset-bottom) + 8px)!important;left:calc(env(safe-area-inset-left) + 8px)!important}.layoutbtn,.invbtn{width:48px!important;height:26px!important;font-size:0!important;border-radius:13px!important}.invbtn:after{content:'🎒';font-size:14px}.layoutbtn:after{content:'✦';font-size:14px}
  .editor,.inventory{backdrop-filter:blur(8px);background:#07100ef2!important}
}
</style>
<style id="v13-equip">.equipbtn{width:38px;height:38px;border:1px solid #66573c;background:#09100e;color:#e4bd6b;border-radius:9px}.equip-panel{position:absolute;z-index:80;right:18px;bottom:96px;width:310px;padding:0;display:none}.equip-panel.open{display:block}.equip-panel header{height:40px;display:flex;align-items:center;padding:0 10px;border-bottom:1px solid #4c4638;color:#e4be73}.equip-panel header button{margin-left:auto;border:0;background:transparent;font-size:20px}.equip-stats{padding:9px;font-size:11px;border-bottom:1px solid #26332d}.gear-row{margin:7px;border:1px solid #465149;padding:7px;display:grid;grid-template-columns:62px 1fr auto;gap:5px;align-items:center;font-size:10px}.gear-row small{color:#89958f}.gear-row.empty{opacity:.48}.invslot small{display:block;font-size:6px;margin-top:2px}@media(pointer:coarse),(max-width:900px){.equip-panel{right:calc(max(env(safe-area-inset-right),46px) + 6px)!important;bottom:calc(max(env(safe-area-inset-bottom),8px) + 64px)!important;width:min(300px,56vw)!important;max-height:68dvh;overflow:auto;backdrop-filter:blur(8px);background:#07100ef2!important}.equipbtn{width:38px!important;height:24px!important;font-size:13px!important;border-radius:12px!important}}</style>
<style id="v14-clean">
.upgrade-banner{position:absolute;z-index:120;left:50%;top:30%;transform:translate(-50%,-50%) scale(.85);padding:12px 20px;border-radius:14px;background:#07100ef2;border:1px solid #73572e;font:800 15px Arial;letter-spacing:.08em;opacity:0;pointer-events:none;transition:.18s}.upgrade-banner.show{opacity:1;transform:translate(-50%,-50%) scale(1)}.upgrade-banner.ok{color:#ffd66c;box-shadow:0 0 28px #ffb02d66}.upgrade-banner.fail{color:#ff7566;box-shadow:0 0 28px #ff443355}
@media(pointer:coarse),(max-width:900px){
:root{--safeL:max(env(safe-area-inset-left),46px);--safeR:max(env(safe-area-inset-right),46px);--safeT:max(env(safe-area-inset-top),7px);--safeB:max(env(safe-area-inset-bottom),7px)}
.player{left:calc(var(--safeL) + 4px)!important;top:var(--safeT)!important;width:156px!important;padding:5px!important;border:0!important;background:#06100dcc!important;box-shadow:none!important}.player-head{font-size:8px!important}.player-head span{font-size:6.5px!important}.meter{height:7px!important;border:0!important;margin-top:3px!important}.meter em{display:none!important}
.zone{top:var(--safeT)!important;font-size:6px!important;padding:3px 8px!important;border:0!important;background:#06100da8!important;letter-spacing:.08em!important}.target{top:calc(var(--safeT) + 31px)!important;width:154px!important;padding:4px 7px!important;border:0!important;background:#06100dcc!important}.target .row{font-size:7px!important}.target .bar{height:4px!important;margin-top:3px!important}
.minimap{right:calc(var(--safeR) + 4px)!important;top:var(--safeT)!important;width:60px!important;height:60px!important;padding:1px!important;border:1px solid #765d34aa!important;box-shadow:none!important}.minimap .map{height:56px!important;border:0!important}.fullscreen-btn{right:calc(var(--safeR) + 69px)!important;top:var(--safeT)!important;height:24px!important;min-width:48px!important;border:0!important;background:#06100dbb!important;box-shadow:none!important;font-size:0!important}.fullscreen-btn:after{content:'⛶';font-size:14px}.fullscreen-btn small{display:none!important}
.joystick{left:calc(var(--safeL) + 2px)!important;bottom:calc(var(--safeB) + 59px)!important;width:88px!important;height:88px!important;border:1px solid #91a28b33!important;background:radial-gradient(circle,#26342c4d 0 30%,#06100d66 32% 68%,transparent 70%)!important;box-shadow:none!important;opacity:.72!important}.joystick:before{inset:16px!important}.joystick-knob{left:29px!important;top:29px!important;width:30px!important;height:30px!important;box-shadow:none!important}
