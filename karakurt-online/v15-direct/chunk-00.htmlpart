*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#050707;color:#e8e2d3;font-family:Arial,Helvetica,sans-serif;user-select:none}button{font:inherit;color:inherit}#game{position:fixed;inset:0;background:#111}canvas{display:block;width:100%;height:100%;touch-action:none;cursor:default}.glass{background:linear-gradient(180deg,#111816eF,#050807eF);border:1px solid #6b5633;box-shadow:0 8px 25px #000b}.top{position:absolute;z-index:20;left:0;right:0;top:0;height:38px;display:flex;align-items:center;padding:0 12px;border-bottom:1px solid #6a512a;background:linear-gradient(#171b1aee,#050707ef);font-size:12px}.brand{font:700 13px Georgia,serif;letter-spacing:.18em;color:#e9c06b}.top .server{margin-left:auto;color:#92a098}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#50d496;box-shadow:0 0 7px #50d496;margin-right:6px}.player{position:absolute;z-index:20;left:12px;top:50px;width:315px;padding:8px 10px}.player-head{display:flex;justify-content:space-between;font-size:12px}.player-head b{color:#f0d9a5}.player-head span{color:#8f9b94}.meter{position:relative;height:15px;margin-top:5px;border:1px solid #313b36;background:#020303;overflow:hidden}.meter i{display:block;height:100%;transition:width .2s}.hp i{background:linear-gradient(90deg,#671d17,#d64d39)}.mp i{background:linear-gradient(90deg,#12364c,#2786b1)}.stam i{background:linear-gradient(90deg,#5b4a12,#d2a82e)}.meter em{position:absolute;inset:0;display:grid;place-items:center;font-size:9px;font-style:normal;text-shadow:0 1px 2px #000}.target{position:absolute;z-index:20;left:50%;top:48px;width:290px;transform:translateX(-50%);padding:7px 10px;text-align:center}.target.hidden{display:none}.target .row{display:flex;justify-content:center;gap:9px;font-size:11px}.target .row b{color:#f0c36a}.target .row span{color:#9da8a1}.target .bar{height:7px;margin-top:6px;background:#220806}.target .bar i{display:block;height:100%;background:#cc4938}.zone{position:absolute;z-index:16;left:50%;top:104px;transform:translateX(-50%);min-width:210px;padding:5px 10px;text-align:center;font-size:10px;letter-spacing:.11em;color:#e1b869;background:#060908d9;border:1px solid #70572f}.zone.safe{color:#78d7ad;border-color:#356b55}.zone.pvp{color:#ff8674;border-color:#8d3025}.minimap{position:absolute;z-index:20;right:12px;top:50px;width:170px;padding:6px}.minimap .map{position:relative;height:105px;margin-top:5px;overflow:hidden;background:radial-gradient(circle,#3c4238,#1a1e1a 60%,#070909);border:1px solid #2e3732}.minimap .map.dungeon{background:radial-gradient(circle,#373b39,#171b1a 60%,#030404)}.minimap .map.pvp{background:radial-gradient(circle,#5a362d,#281612 62%,#060303)}.minimap b{font-size:10px;color:#d6b878}.mini-you,.mini-mob,.mini-npc{position:absolute;width:6px;height:6px;border-radius:50%}.mini-you{left:50%;top:50%;background:#5ddcff;box-shadow:0 0 7px #5ddcff}.mini-mob{background:#e94b3d}.mini-npc{background:#f0ce56}.quest{position:absolute;z-index:18;right:12px;top:190px;width:230px;padding:8px;font-size:10px;line-height:1.45}.quest b{color:#dfb65f}.msg{position:absolute;z-index:25;left:50%;bottom:110px;transform:translateX(-50%);max-width:560px;padding:6px 10px;color:#e6d1a7;background:#030505cc;border:1px solid #51472f;font-size:11px;text-align:center;pointer-events:none}.chat{position:absolute;z-index:18;left:12px;bottom:100px;width:330px;max-height:88px;padding:7px;overflow:hidden;font-size:10px;color:#aab4ae}.chat p{margin:3px 0}.chat b{color:#d5a752}.hotbar{position:absolute;z-index:30;left:0;right:0;bottom:0;height:88px;display:flex;align-items:flex-end;justify-content:center;padding:9px 140px 10px;background:linear-gradient(transparent,#050808dc 28%,#050707f5);border-top:1px solid #3e382a}.xp{position:absolute;left:0;right:0;top:0;height:5px;background:#071117}.xp i{display:block;height:100%;background:#2b9fcb}.slots{display:flex;gap:4px}.slot{position:relative;width:58px;height:60px;border:1px solid #5c4c35;background:radial-gradient(circle at 50% 30%,#28312c,#080b0a 72%);color:#dbaa54;cursor:pointer;overflow:hidden}.slot:hover{border-color:#b58442}.slot.active{border-color:#70b9dc;box-shadow:0 0 12px #4b9dc666}.slot kbd{position:absolute;left:4px;top:3px;font-size:9px;color:#f1d8a8}.slot .icon{font-size:21px}.slot small{position:absolute;left:2px;right:2px;bottom:3px;font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#a8b2ac}.slot .cd{position:absolute;inset:0;display:grid;place-items:center;background:#000b;color:#f3d7a0;font-weight:bold}.money{position:absolute;right:15px;bottom:18px;text-align:right;font-size:10px;color:#8e9993}.money b{display:block;color:#e2b960;font-size:12px}.sidebtns{position:absolute;left:15px;bottom:12px;display:flex;gap:5px}.layoutbtn,.invbtn{width:92px;height:38px;border:1px solid #725a34;background:#0b100f;color:#d5ae61;font-size:9px;cursor:pointer}.invbtn{border-color:#486558;color:#8ed3b4}.auto-ind{position:absolute;left:130px;bottom:21px;font-size:9px;color:#7f8a84}.auto-ind b{color:#e3ba61}.editor{position:absolute;z-index:60;left:50%;bottom:98px;width:min(680px,94vw);transform:translateX(-50%);padding:10px;display:none}.editor.open{display:block}.editor-head{display:flex;align-items:center;margin-bottom:8px}.editor-head b{color:#e0b865;font-size:11px}.editor-head button{margin-left:auto;background:transparent;border:0;color:#bbb;font-size:18px;cursor:pointer}.skillpool{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.skillpool button{min-height:52px;border:1px solid #3c463f;background:#0c1210;color:#d9af63;text-align:left;padding:7px;cursor:pointer}.skillpool button b,.skillpool button small{display:block}.skillpool button small{color:#7f8b84;font-size:9px;margin-top:3px}.dialog{position:absolute;z-index:70;left:50%;top:50%;width:min(430px,90vw);transform:translate(-50%,-50%);padding:0;display:none}.dialog.open{display:block}.dialog header{height:42px;display:flex;align-items:center;padding:0 11px;border-bottom:1px solid #3d4541;color:#e4be73}.dialog header button{margin-left:auto;border:0;background:transparent;font-size:20px;cursor:pointer}.dialog .body{padding:12px;font-size:11px;color:#aab5ae;line-height:1.5}.dialog .body button{width:100%;min-height:40px;margin-top:7px;border:1px solid #765427;background:linear-gradient(#563914,#2b1c0b);color:#efce8c;cursor:pointer}.inventory{position:absolute;z-index:75;right:18px;bottom:96px;width:360px;max-width:92vw;padding:0;display:none}.inventory.open{display:block}.inventory header{height:40px;display:flex;align-items:center;padding:0 10px;border-bottom:1px solid #4c4638;color:#e4be73}.inventory header button{margin-left:auto;border:0;background:transparent;font-size:20px;cursor:pointer}.invbody{padding:10px}.invmeta{display:flex;justify-content:space-between;margin-bottom:8px;font-size:10px;color:#a8b3ad}.invgrid{display:grid;grid-template-columns:repeat(6,1fr);gap:5px}.invslot{aspect-ratio:1;border:1px solid #3d493f;background:radial-gradient(circle,#1a211d,#070a09 72%);display:grid;place-items:center;padding:3px;text-align:center;font-size:8px;color:#c6b98d;overflow:hidden}.invslot.filled{border-color:#705a36;color:#efd18a}.invslot .ico{display:block;font-size:19px;margin-bottom:2px}.safe-badge{position:absolute;z-index:25;left:50%;top:132px;transform:translateX(-50%);font-size:9px;color:#7be0ae;background:#06120dcc;border:1px solid #286a4c;padding:4px 8px;display:none}.safe-badge.on{display:block}.combo-hud{position:absolute;z-index:36;left:50%;top:148px;transform:translateX(-50%) scale(.9);font:900 18px Georgia,serif;color:#ffd779;text-shadow:0 2px 5px #000;opacity:0;transition:.12s}.combo-hud.on{opacity:1;transform:translateX(-50%) scale(1)}.combat-state{position:absolute;z-index:24;left:12px;top:152px;padding:3px 7px;font-size:8px;letter-spacing:.08em;color:#9eb0a6;background:#040807a8;border-left:2px solid #876b3a}.mobile{display:none}.rotate-note{position:absolute;inset:0;z-index:200;display:none;place-items:center;padding:30px;background:#040706f5;color:#e4be73;text-align:center;font-weight:bold}.damage{position:absolute;z-index:35;pointer-events:none;color:#ffdf91;font:bold 16px Arial;text-shadow:0 2px 3px #000;animation:float .7s forwards}@keyframes float{to{transform:translateY(-35px);opacity:0}}.death{position:absolute;z-index:100;inset:0;display:none;place-items:center;background:#1800009c;backdrop-filter:blur(2px)}.death.open{display:grid}.death .box{padding:24px;text-align:center}.death h2{margin:0 0 8px;color:#e66b58}.death button{margin-top:12px;padding:10px 28px;border:1px solid #96603b;background:#42250e;color:#f0c982;cursor:pointer}
