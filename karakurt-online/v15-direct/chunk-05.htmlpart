m.plus||0}}else{old=state.equipment[item.slot];state.equipment[item.slot]=item}if(old)state.loot[i]=old;else state.loot.splice(i,1);refreshWeaponVisual();refreshEquipmentVisual();saveGear();sfx('equip');renderInventory();renderEquipment();renderHud();message(`${item.name} kuşanıldı.`)}
function initEquipmentUI(){const b=document.createElement('button');b.id='equipBtn';b.className='equipbtn';b.textContent='⚔';document.querySelector('.sidebtns')?.appendChild(b);const p=document.createElement('div');p.id='equipPanel';p.className='equip-panel glass';p.innerHTML='<header><b>EKİPMAN</b><button id="equipClose">×</button></header><div id="equipBody"></div>';game.appendChild(p);b.onclick=()=>{p.classList.toggle('open');renderEquipment()};p.querySelector('#equipClose').onclick=()=>p.classList.remove('open')}
function renderEquipment(){const p=$('#equipBody');if(!p)return;const w=state.weapon,slots=[['weapon','Silah',w],['helmet','Miğfer',state.equipment.helmet],['armor','Zırh',state.equipment.armor],['boots','Çizme',state.equipment.boots],['ring','Yüzük',state.equipment.ring]];p.innerHTML=`<div class='equip-stats'>ATK <b>${w.atk+gearAttack()}</b> · DEF <b>${gearDefense()}</b> · Taş <b>${state.upgradeStones}</b></div>`+slots.map(([k,n,x])=>{if(!x)return`<div class='gear-row empty'><span>${n}</span><small>Boş</small></div>`;const r=rarityData[x.rarity||'common'];return`<div class='gear-row' style='border-color:${r.c}'><span>${n}</span><b style='color:${r.c}'>${x.name}${x.plus?` +${x.plus}`:''}</b><small>${x.atk?`ATK ${x.atk}`:''}${x.def?` DEF ${x.def}`:''}</small></div>`}).join('')}
function visibleMap(objMap){return objMap===currentMap}function syncVisibility(){mobs.forEach(m=>m.mesh.visible=visibleMap(m.map)&&m.alive);npcs.forEach(n=>n.mesh.visible=visibleMap(n.map));portals.forEach(p=>p.mesh.visible=visibleMap(p.map));groundMeshes.forEach(g=>g.visible=g.userData.map===currentMap);worldLoot.forEach(l=>l.mesh.visible=l.map===currentMap);setTarget(null);const o=MAPS[currentMap].origin;player.position.set(o.x,0,o.z+(currentMap==='bozkir'?7:17));moveTarget=null;pending=null;ui.mapName.textContent=MAPS[currentMap].name;ui.mini.className='map '+(currentMap==='dungeon'?'dungeon':currentMap==='pvp'?'pvp':'');message(`Bölge: ${MAPS[currentMap].name}`)}
function message(t){ui.msg.textContent=t;const p=document.createElement('p');p.innerHTML='<b>[System]</b> '+t;ui.chat.appendChild(p);while(ui.chat.children.length>5)ui.chat.removeChild(ui.chat.firstChild)}
function setTarget(m){target=m;if(!m||!m.alive){target=null;ui.target.classList.add('hidden');return}ui.target.classList.remove('hidden');ui.tname.textContent=m.name;ui.tlevel.textContent=`Lv ${m.level}${m.boss?' · BOSS':''}`;updateTarget()}
function updateTarget(){if(target&&target.alive)ui.thp.style.width=(target.hp/target.maxHp*100)+'%'}
function nearest(max=32){let best=null,bd=max;for(const m of mobs){if(!m.alive||m.map!==currentMap)continue;const d=player.position.distanceTo(m.mesh.position);if(d<bd){bd=d;best=m}}return best}
function targetNearest(){const m=nearest();if(m){setTarget(m);message(`Hedef: ${m.name}`)}else message('Yakında hedef yok.')}
function toggleAuto(){if(state.dead)return;if(!target||!target.alive)setTarget(nearest());state.auto=!state.auto;if(!target)state.auto=false;message(`Basic auto attack ${state.auto?'AÇIK':'KAPALI'}.`);renderHud()}
function toggleAfk(){if(currentMap==='pvp'){message('AFK farm PvP bölgesinde kapalı.');return}state.afk=!state.afk;if(state.afk){state.auto=true;if(!target)setTarget(nearest())}message(`AFK slot modu ${state.afk?'AÇIK':'KAPALI'}.`);renderHud()}
function damagePlayer(n,source=null){const now=performance.now();if(state.dead||isSafeZone()||now<state.invulnUntil)return;if(now<state.guardUntil)n*=.35;n*=100/(100+gearDefense()*1.7);state.hp=Math.max(0,state.hp-Math.round(n));state.screenShake=Math.min(.65,state.screenShake+.22);state.hitStunUntil=now+220;setCombatState('hit',state.hitStunUntil);if(source){const kb=player.position.clone().sub(source).setY(0);if(kb.lengthSq()>.001){kb.normalize();player.position.addScaledVector(kb,.28)}}if(state.hp<=0)die();renderHud()}
function die(){state.dead=true;state.auto=false;state.afk=false;pendingAttack=null;setCombatState('dead');keys.w=keys.a=keys.s=keys.d=false;ui.death.classList.add('open');message('Öldün. Karahisar yeniden doğuş noktasına dön.')}
function respawn(){currentMap='bozkir';state.dead=false;state.hp=state.maxHp;state.mp=state.maxMp;state.stamina=state.maxStamina;state.invulnUntil=performance.now()+1200;setCombatState('idle');ui.death.classList.remove('open');syncVisibility();renderHud()}
function lootColor(item){if(typeof item==='object'&&item?.kind==='gear')return {common:0xb7c0bb,rare:0x58b8ff,epic:0xb96cff,legendary:0xffb347}[item.rarity||'common'];if(item==='Minor Potion'||item?.kind==='potion')return 0x55e89a;if(item?.kind==='stone'||item==='Yükseltme Taşı')return 0xffd15a;return 0xd8c99a}
function spawnGroundLoot(item,pos,map=currentMap){const c=lootColor(item),g=new THREE.Group();const orb=new THREE.Mesh(new THREE.OctahedronGeometry(.18,0),new THREE.MeshBasicMaterial({color:c,transparent:true,opacity:.96}));orb.position.y=.32;const beam=new THREE.Mesh(new THREE.CylinderGeometry(.035,.11,2.2,8,1,true),new THREE.MeshBasicMaterial({color:c,transparent:true,opacity:.25,side:THREE.DoubleSide,depthWrite:false,blending:THREE.AdditiveBlending}));beam.position.y=1.1;g.add(orb,beam);g.position.copy(pos);g.position.x+=(Math.random()-.5)*.8;g.position.z+=(Math.random()-.5)*.8;const l={kind:'loot',item,map,mesh:g,spawnAt:performance.now(),phase:Math.random()*6.28};g.userData.entity=l;g.traverse(x=>x.userData.entity=l);scene.add(g);worldLoot.push(l);state.lootHintUntil=performance.now()+2500;return l}
function collectWorldLoot(l){const i=worldLoot.indexOf(l);if(i<0)return;const item=l.item;if(item==='Minor Potion'||item?.kind==='potion')state.potions+=(item.count||1);else if(item==='Yükseltme Taşı'||item?.kind==='stone')state.upgradeStones+=(item.count||1);else{if(state.loot.length>=24){message('Çanta dolu. Loot yerde kaldı.');return}state.loot.push(item)}scene.remove(l.mesh);worldLoot.splice(i,1);sfx('equip');saveProgress();renderHud();if(ui.inventory.classList.contains('open'))renderInventory();message(`Loot alındı: ${typeof item==='string'?item:item.name||'Eşya'}`)}
function updateWorldLoot(dt,now){for(const l of [...worldLoot]){l.mesh.visible=l.map===currentMap;if(!l.mesh.visible)continue;l.mesh.rotation.y+=dt*1.6;l.mesh.position.y=.02+Math.sin(now*.003+l.phase)*.045;const d=l.mesh.position.distanceTo(player.position);if((state.afk&&d<2.6)||d<1.05)collectWorldLoot(l);else if(now-l.spawnAt>90000){scene.remove(l.mesh);worldLoot.splice(worldLoot.indexOf(l),1)}}}
function makeGearDrop(m){if(Math.random()>(m.boss?.72:.20))return null;const slot=['weapon','helmet','armor','boots','ring'][Math.floor(Math.random()*5)],rarity=rarityRoll(m.boss),rd=rarityData[rarity],lv=Math.max(1,m.level),names={weapon:['Börü Kılıcı','Karakuyu Palası','Sınır Muhafızı Kılıcı'],helmet:['Bozkır Miğferi','Karakuyu Başlığı'],armor:['Bozkır Zırhı','Muhafız Zırhı'],boots:['Avcı Çizmesi','Demir Çizme'],ring:['Kurt Gözü Yüzüğü','Karakuyu Mührü']};return {kind:'gear',slot,rarity,name:names[slot][Math.floor(Math.random()*names[slot].length)],plus:0,atk:slot==='weapon'?Math.round((8+lv*3)*rd.m):slot==='ring'?Math.round((2+lv)*rd.m):0,def:['helmet','armor','boots'].includes(slot)?Math.round((4+lv*2+(slot==='armor'?5:0))*rd.m):0}}
function spawnKillLoot(m){const drops=['Kurt Dişi','Eski Bronz Parçası','Minor Potion','Keten Kumaş'];if(Math.random()<.72)spawnGroundLoot(drops[Math.floor(Math.random()*drops.length)],m.mesh.position.clone(),m.map);const gear=makeGearDrop(m);if(gear)spawnGroundLoot(gear,m.mesh.position.clone(),m.map);if(Math.random()<(m.boss?.65:.22))spawnGroundLoot({kind:'stone',name:'Yükseltme Taşı',count:1},m.mesh.position.clone(),m.map)}
function spawnSkillFx(id,m){const pos=player.position.clone(),fwd=new THREE.Vector3(Math.sin(player.rotation.y),0,Math.cos(player.rotation.y));if(id==='thrust'){const fx=new THREE.Mesh(new THREE.CylinderGeometry(.055,.12,2.7,10),new THREE.MeshBasicMaterial({color:0x7ad7ff,transparent:true,opacity:.75,blending:THREE.AdditiveBlending}));fx.rotation.x=Math.PI/2;fx.position.copy(pos).addScaledVector(fwd,1.5);fx.position.y=1.35;fx.rotation.z=-player.rotation.y;scene.add(fx);effects.push({mesh:fx,life:.22,max:.22,type:'slash'})}else if(id==='cleave'||id==='provoke'){const col=id==='cleave'?0xff8b43:0xffd15a,fx=new THREE.Mesh(new THREE.RingGeometry(.9,3.1,40),new THREE.MeshBasicMaterial({color:col,transparent:true,opacity:.55,side:THREE.DoubleSide,depthWrite:false,blending:THREE.AdditiveBlending}));fx.rotation.x=-Math.PI/2;fx.position.copy(pos);fx.position.y=.08;scene.add(fx);effects.push({mesh:fx,life:.38,max:.38,type:'slash'})}else if(id==='guard'){const fx=new THREE.Mesh(new THREE.SphereGeometry(1.25,18,14),new THREE.MeshBasicMaterial({color:0x64baff,transparent:true,opacity:.15,wireframe:true}));fx.position.copy(pos);fx.position.y=1.5;scene.add(fx);effects.push({mesh:fx,life:.65,max:.65,type:'slash'})}else if(id==='dash'){for(let i=0;i<6;i++){const fx=new THREE.Mesh(new THREE.SphereGeometry(.12,8,6),new THREE.MeshBasicMaterial({color:0xc6e9ff,transparent:true,opacity:.45}));fx.position.copy(pos).addScaledVector(fwd,-i*.25);fx.position.y=.4+i*.16;scene.add(fx);effects.push({mesh:fx,life:.28,max:.28,type:'slash'})}}}
function gainKill(m){state.xp+=m.exp;state.coins+=m.coins;if(m.kind==='enemy')state.np+=10;if(currentMap==='bozkir'&&m.kind==='wolf')state.kills++;spawnKillLoot(m);saveProgress();while(state.xp>=state.nextXp){state.xp-=state.nextXp;state.level++;state.nextXp=Math.round(state.nextXp*1.32);state.maxHp+=55;state.maxMp+=16;state.hp=state.maxHp;state.mp=state.maxMp;message(`LEVEL UP! Seviye ${state.level}.`)}if(state.kills>=5)$('#questText').textContent='5/5 Kurt öldürüldü. Karahisar Muhafızı ile konuş.';renderHud()}
function killMob(m){m.alive=false;m.mesh.visible=false;m.respawnAt=performance.now()+(m.boss?22000:8000);gainKill(m);if(target===m)setTarget(null);state.auto=false;if(state.afk){setTimeout(()=>{const n=nearest();if(n){setTarget(n);state.auto=true}},450)}message(`${m.name} öldürüldü. +${m.exp} EXP +${m.coins} coin`)}
function hit(m,dmg,tag='R',canCrit=true){if(!m||!m.alive)return;const now=performance.now(),crit=canCrit&&Math.random()<.12;if(crit)dmg*=1.65;dmg=Math.round(dmg);m.hp=Math.max(0,m.hp-dmg);m.hitStunUntil=now+(m.boss?90:150);if(!m.boss){const kb=m.mesh.position.clone().sub(player.position).setY(0);if(kb.lengthSq()>.001)m.mesh.position.addScaledVector(kb.normalize(),.16)}updateTarget();floatDamage(dmg,m.mesh.position,crit);spawnHitFx(m.mesh.position,crit);sfx(crit?'crit':'hit');if(!m.aggro)m.aggro=true;if(m.hp<=0)killMob(m);else if(tag!=='R')message(`${tag}: ${dmg}${crit?' KRİTİK':''} hasar.`)}
function floatDamage(n,pos,crit=false){const v=pos.clone();v.y+=2.7;v.project(camera);const d=document.createElement('div');d.className='damage';d.textContent=(crit?'CRIT ':'')+'-'+n;d.style.color=crit?'#fff199':'#ffdf91';d.style.fontSize=crit?'21px':'16px';d.style.left=((v.x*.5+.5)*innerWidth)+'px';d.style.top=((-v.y*.5+.5)*innerHeight)+'px';game.appendChild(d);setTimeout(()=>d.remove(),750)}
function queueAttack(m,{tag='R',damage=45,windup=180,recovery=440,power=1,aoe=false,range=2.55,canCrit=true}={}){const now=performance.now();if(pendingAttack||state.dead||now<state.hitStunUntil||now<state.dodgeUntil)return false;player.lookAt(m.mesh.position.x,player.position.y,m.mesh.position.z);pendingAttack={target:m,impactAt:now+windup,endAt:now+windup+recovery,tag,damage,aoe,range,canCrit,done:false};startAttackAnim(power,windup+recovery);return true}
function processPendingAttack(now){const a=pendingAttack;if(!a)return;if(!a.done&&now>=a.impactAt){a.done=true;spawnSlashFx(a.tag==='R'?1:1.12);if(a.aoe){for(const m of mobs)if(m.alive&&m.map===currentMap&&m.mesh.position.distanceTo(player.position)<3.35)hit(m,a.damage,a.tag,a.canCrit)}else if(a.target?.alive&&player.position.distanceTo(a.target.mesh.position)<=a.range)hit(a.target,a.damage,a.tag,a.canCrit)}if(now>=a.endAt)pendingAttack=null}
function basicAttack(){if(isSafeZone()){state.auto=false;renderHud();return}if(!target||!target.alive)return;const d=player.position.distanceTo(target.mesh.position);if(d>2.15){if(!pendingAttack)moveTarget=target.mesh.position.clone();return}moveTarget=null;const now=performance.now();if(pendingAttack||now-lastAttack<710||now<state.hitStunUntil||now<state.dodgeUntil)return;if(now<state.comboUntil)state.combo=Math.min(3,state.combo+1);else state.combo=1;state.comboUntil=now+1350;ui.combo.textConte