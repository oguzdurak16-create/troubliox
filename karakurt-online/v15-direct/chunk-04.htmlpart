8ced0,rare:0x62b8ff,epic:0xb879ff,legendary:0xffc35a}[rar];p.swordMat.color.set(plus>=7?0xffd36a:col);p.swordMat.emissive.set(plus>=7?0xff8a20:rar==='legendary'?0xa85a00:rar==='epic'?0x47128c:rar==='rare'?0x124a7a:0x000000);p.swordMat.emissiveIntensity=plus>=7?1.15:rar==='common'?0:.55;p.swordGuard.scale.x=1+plus*.025}
function refreshEquipmentVisual(){const p=player.userData.parts;if(!p)return;const rank={common:0,rare:1,epic:2,legendary:3};let best='common';for(const it of [state.equipment.helmet,state.equipment.armor,state.equipment.boots])if(it&&rank[it.rarity]>rank[best])best=it.rarity;const cols={common:0x3f4b54,rare:0x355c78,epic:0x584070,legendary:0x7a5429};const em={common:0x000000,rare:0x09213a,epic:0x250c42,legendary:0x4c2600};p.body.material.color.set(cols[best]);p.body.material.emissive?.set(em[best]);p.body.material.emissiveIntensity=best==='common'?0:.16;if(p.helm){p.helm.material.color.set(cols[best]);p.helm.material.emissive?.set(em[best]);p.helm.material.emissiveIntensity=best==='common'?0:.16}}
let audioCtx=null;function ensureAudio(){try{audioCtx ||= new (window.AudioContext||window.webkitAudioContext)();if(audioCtx.state==='suspended')audioCtx.resume()}catch{}}function sfx(kind='hit'){if(!audioCtx)return;const o=audioCtx.createOscillator(),g=audioCtx.createGain();const t=audioCtx.currentTime;const cfg={hit:[150,.035,.08],crit:[260,.055,.12],pot:[620,.035,.13],up:[880,.06,.22],fail:[95,.055,.2],equip:[440,.025,.09]}[kind]||[180,.03,.08];o.type=kind==='pot'?'sine':kind==='fail'?'sawtooth':'triangle';o.frequency.setValueAtTime(cfg[0],t);if(kind==='up')o.frequency.exponentialRampToValueAtTime(1320,t+cfg[2]);g.gain.setValueAtTime(cfg[1],t);g.gain.exponentialRampToValueAtTime(.0001,t+cfg[2]);o.connect(g).connect(audioCtx.destination);o.start(t);o.stop(t+cfg[2])}
function showUpgradeBanner(ok){let d=$('#upgradeBanner');if(!d){d=document.createElement('div');d.id='upgradeBanner';d.className='upgrade-banner';game.appendChild(d)}d.className='upgrade-banner show '+(ok?'ok':'fail');d.textContent=ok?`YÜKSELTME BAŞARILI  +${state.weapon.plus}`:'YÜKSELTME BAŞARISIZ';setTimeout(()=>d.classList.remove('show'),900)}
function saveProgress(){try{localStorage.setItem('karakurt-progress-v15',JSON.stringify({level:state.level,xp:state.xp,nextXp:state.nextXp,coins:state.coins,np:state.np,kills:state.kills,potions:state.potions,loot:state.loot,weapon:state.weapon,equipment:state.equipment,upgradeStones:state.upgradeStones}))}catch{}}
function loadProgress(){try{const x=JSON.parse(localStorage.getItem('karakurt-progress-v15')||'null');if(!x)return;for(const k of ['level','xp','nextXp','coins','np','kills','potions','upgradeStones'])if(Number.isFinite(x[k]))state[k]=x[k];if(Array.isArray(x.loot))state.loot=x.loot;if(x.weapon)state.weapon=x.weapon;if(x.equipment)state.equipment=x.equipment}catch{}}
function updateWorldLabels(){const max=isMobile?10.5:18;for(const m of mobs){if(!m.label)continue;m.label.visible=m.alive&&m.map===currentMap&&(m===target||m.boss||m.mesh.position.distanceTo(player.position)<max)}for(const n of npcs){if(n.label)n.label.visible=n.map===currentMap&&n.mesh.position.distanceTo(player.position)<(isMobile?13:22)}}
function upgradeWeapon(){if(state.upgradeStones<=0){message('Yükseltme taşı yok.');return}const p=state.weapon.plus,chance=p<3?1:p<6?.72:p<8?.48:.28;state.upgradeStones--;state.upgradeFxUntil=performance.now()+1200;const ok=Math.random()<chance;if(ok){state.weapon.plus++;state.weapon.atk+=4+state.weapon.plus*2;message(`Yükseltme başarılı! ${state.weapon.name} +${state.weapon.plus}`)}else{if(p>=7&&Math.random()<.35)state.weapon.plus=Math.max(0,p-1);message('Yükseltme başarısız.')}refreshWeaponVisual();refreshEquipmentVisual();spawnUpgradeFx(ok);showUpgradeBanner(ok);sfx(ok?'up':'fail');saveGear();saveProgress();npcDialog({role:'blacksmith',name:'Demirci Börü'})}
function itemUpgradeChance(plus){return plus<3?1:plus<6?.72:plus<8?.48:.28}
function upgradeCost(plus){return {coin:Math.round(120*(plus+1)*(plus+1)),stones:plus<4?1:plus<7?2:3}}
function upgradeInventoryItem(idx){const it=state.loot[idx];if(!it||typeof it==='string'||it.kind!=='gear')return;const cost=upgradeCost(it.plus||0),chance=itemUpgradeChance(it.plus||0);if(state.upgradeStones<cost.stones){message('Yeterli yükseltme taşı yok.');return}if(state.coins<cost.coin){message('Yeterli coin yok.');return}state.upgradeStones-=cost.stones;state.coins-=cost.coin;const ok=Math.random()<chance;if(ok){it.plus=(it.plus||0)+1;if(it.atk)it.atk+=3+it.plus*2;if(it.def)it.def+=2+it.plus;message(`${it.name} +${it.plus} oldu!`)}else{if((it.plus||0)>=7&&Math.random()<.35)it.plus--;message(`${it.name} yükseltme başarısız.`)}spawnUpgradeFx(ok);showUpgradeBanner(ok);sfx(ok?'up':'fail');saveProgress();renderInventory();npcDialog({role:'blacksmith',name:'Demirci Börü'})}
function upgradeEquippedWeapon(){const cost=upgradeCost(state.weapon.plus||0);if(state.upgradeStones<cost.stones){message('Yeterli yükseltme taşı yok.');return}if(state.coins<cost.coin){message('Yeterli coin yok.');return}state.upgradeStones-=cost.stones;state.coins-=cost.coin;const p=state.weapon.plus||0,ok=Math.random()<itemUpgradeChance(p);if(ok){state.weapon.plus=p+1;state.weapon.atk+=4+state.weapon.plus*2}else if(p>=7&&Math.random()<.35)state.weapon.plus=p-1;refreshWeaponVisual();spawnUpgradeFx(ok);showUpgradeBanner(ok);sfx(ok?'up':'fail');saveGear();saveProgress();npcDialog({role:'blacksmith',name:'Demirci Börü'})}
function spawnUpgradeFx(ok){const c=ok?0xffd86a:0xff4c3c;for(let i=0;i<18;i++){const m=new THREE.Mesh(new THREE.SphereGeometry(.035+Math.random()*.04,6,5),new THREE.MeshBasicMaterial({color:c,transparent:true,opacity:.95,depthWrite:false}));m.position.copy(player.position).add(new THREE.Vector3((Math.random()-.5)*1.4,1+Math.random()*2.4,(Math.random()-.5)*1.2));scene.add(m);effects.push({mesh:m,life:.7+Math.random()*.4,max:1,type:'particle',v:new THREE.Vector3((Math.random()-.5)*2,1.2+Math.random()*2,(Math.random()-.5)*2)})}state.screenShake=ok?.18:.32}
const rarityData={common:{n:'Sıradan',c:'#aab3ae',m:1},rare:{n:'Nadir',c:'#55aaff',m:1.25},epic:{n:'Epik',c:'#b86cff',m:1.6},legendary:{n:'Efsanevi',c:'#ffb347',m:2.1}};
function gearAttack(){let v=0;for(const x of Object.values(state.equipment))if(x)v+=x.atk||0;return v}
function gearDefense(){let v=0;for(const x of Object.values(state.equipment))if(x)v+=x.def||0;return v}
function rarityRoll(boss=false){const r=Math.random();if(boss&&r<.09)return'legendary';if(r<(boss?.34:.06))return'epic';if(r<(boss?.72:.28))return'rare';return'common'}
function rollGear(m){if(Math.random()>(m.boss?.72:.20))return;const slot=['weapon','helmet','armor','boots','ring'][Math.floor(Math.random()*5)],rarity=rarityRoll(m.boss),rd=rarityData[rarity],lv=Math.max(1,m.level),names={weapon:['Börü Kılıcı','Karakuyu Palası','Sınır Muhafızı Kılıcı'],helmet:['Bozkır Miğferi','Karakuyu Başlığı'],armor:['Bozkır Zırhı','Muhafız Zırhı'],boots:['Avcı Çizmesi','Demir Çizme'],ring:['Kurt Gözü Yüzüğü','Karakuyu Mührü']};const item={kind:'gear',slot,rarity,name:names[slot][Math.floor(Math.random()*names[slot].length)],plus:0,atk:slot==='weapon'?Math.round((8+lv*3)*rd.m):slot==='ring'?Math.round((2+lv)*rd.m):0,def:['helmet','armor','boots'].includes(slot)?Math.round((4+lv*2+(slot==='armor'?5:0))*rd.m):0};state.loot.push(item);message(`${rd.n} eşya düştü: ${item.name}`)}
function saveGear(){localStorage.setItem('karakurt-gear',JSON.stringify({weapon:state.weapon,equipment:state.equipment,upgradeStones:state.upgradeStones}));saveProgress()}
function loadGear(){try{const x=JSON.parse(localStorage.getItem('karakurt-gear')||'null');if(x){if(x.weapon)state.weapon=x.weapon;if(x.equipment)state.equipment=x.equipment;if(Number.isFinite(x.upgradeStones))state.upgradeStones=x.upgradeStones}}catch{}}
function equipItem(i){const item=state.loot[i];if(!item||typeof item==='string'||item.kind!=='gear')return;let old=null;if(item.slot==='weapon'){old={kind:'gear',slot:'weapon',name:state.weapon.name,rarity:state.weapon.rarity||'common',atk:state.weapon.atk,def:0,plus:state.weapon.plus||0};state.weapon={name:item.name,rarity:item.rarity,atk:item.atk,plus:item.plus||0}}else{old=state.equipment[item.slot];state.equipment[item.slot]=item}if(old)state.loot[i]=old;else state.loot.splice(i,1);refreshWeaponVisual();refreshEquipmentVisual();saveGear();sfx('equip');renderInventory();renderEquipment();renderHud();message(`${item.name} kuşanıldı.`)}
function initEquipmentUI(){const b=document.createElement('button');b.id='equipBtn';b.className='equipbtn';b.textContent='⚔';document.querySelector('.sidebtns')?.appendChild(b);const p=document.createElement('div');p.id='equipPanel';p.className='equip-panel glass';p.innerHTML='<header><b>EKİPMAN</b><button id="equipClose">×</button></header><div id="equipBody"></div>';game.appendChild(p);b.onclick=()=>{p.classList.toggle('open');renderEquipment()};p.querySelector('#equipClose').onclick=()=>p.classList.remove('open')}
function renderEquipment(){const p=$('#equipBody');if(!p)return;const w=state.weapon,slots=[['weapon','Silah',w],['helmet','Miğfer',state.equipment.helmet],['armor','Zırh',state.equipment.armor],['boots','Çizme',state.equipment.boots],['ring','Yüzük',state.equipment.ring]];p.innerHTML=`<div class='equip-stats'>ATK <b>${w.atk+gearAttack()}</b> · DEF <b>${gearDefense()}</b> · Taş <b>${state.upgradeStones}</b></div>`+slots.map(([k,n,x])=>{if(!x)return`<div class='gear-row empty'><span>${n}</span><small>Boş</small></div>`;const r=rarityData[x.rarity||'common'];return`<div class='gear-row' style='border-color:${r.c}'><span>${n}</span><b style='color:${r.c}'>${x.name}${x.plus?` +${x.plus}`:''}</b><small>${x.atk?`ATK ${x.atk}`:''}${x.def?` DEF ${x.def}`:''}</small></div>`}).join('')}
function visibleMap(objMap){return objMap===currentMap}function syncVisibility(){mobs.forEach(m=>m.mesh.visible=visibleMap(m.map)&&m.alive);npcs.forEach(n=>n.mesh.visible=visibleMap(n.map));portals.forEach(p=>p.mesh.visible=visibleMap(p.map));groundMeshes.forEach(g=>g.visible=g.userData.map===currentMap);worldLoot.forEach(l=>l.mesh.visible=l.map===currentMap);setTarget(null);const o=MAPS[currentMap].origin;player.position.set(o.x,0,o.z+(currentMap==='bozkir'?7:17));moveTarget=null;pending=null;ui.mapName.textContent=MAPS[currentMap].name;ui.mini.className='map '+(currentMap==='dungeon'?'dungeon':currentMap==='pvp'?'pvp':'');message(`Bölge: ${MAPS[currentMap].name}`)}
function message(t){ui.msg.textContent=t;const p=document.createElement('p');p.innerHTML='<b>[System]</b> '+t;ui.chat.appendChild(p);while(ui.chat.children.length>5)ui.chat.removeChild(ui.chat.firstChild)}
function setTarget(m){target=m;if(!m||!m.alive){target=null;ui.target.classList.add('hidden');return}ui.target.classList.remove('hidden');ui.tname.textContent=m.name;ui.tlevel.textContent=`Lv ${m.level}${m.boss?' · BOSS':''}`;updateTarget()}
function updateTarget(){if(target&&target.alive)ui.thp.style.width=(target.hp/target.maxHp*100)+'%'}
function nearest(max=32){let best=null,bd=max;for(const m of mobs){if(!m.alive||m.map!==currentMap)continue;const d=player.position.distanceTo