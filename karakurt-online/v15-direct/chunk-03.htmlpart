g.userData.sword=sword;g.userData.swordMat=sword.userData.bladeMat;g.userData.swordGuard=sword.userData.guard;g.userData.swordBaseZ=sword.rotation.z;g.userData.shield=shield;g.userData.parts={body:torso,chest,head,helm,leftLeg,rightLeg,leftArm,rightArm,leftShoulder,rightShoulder,cape:cloak,sword,shield,leftBoot,rightBoot};g.userData.base={bodyY:torso.position.y,headY:head.position.y,capeY:cloak.position.y};return g}
function mobModel(kind){const g=new THREE.Group();if(kind==='skeleton'){const bone=mat(0xd7d2b9);const b=new THREE.Mesh(new THREE.BoxGeometry(.62,1.2,.35),bone);b.position.y=1.5;const h=new THREE.Mesh(new THREE.SphereGeometry(.32,10,8),bone);h.position.y=2.35;const l=box(.18,1,.2,0xc8c1a7);l.position.set(-.18,.55,0);const r=l.clone();r.position.x=.18;g.add(b,h,l,r)}else if(kind==='enemy'){g.add(warrior(0x5a2823,0x151010));g.scale.set(.85,.85,.85)}else{const col=kind==='boar'?0x4b3325:0x3e4141;const body=new THREE.Mesh(new THREE.BoxGeometry(1.4,.7,.65),mat(col));body.position.y=.75;const head=new THREE.Mesh(new THREE.BoxGeometry(.65,.62,.58),mat(col));head.position.set(0, .85,-.82);for(const x of [-.45,.45])for(const z of [-.25,.25]){const leg=box(.18,.65,.18,0x2d2925);leg.position.set(x,.32,z);g.add(leg)}g.add(body,head)}return g}
const player=warrior();player.position.set(0,0,7);player.rotation.y=Math.PI;scene.add(player);
const groundMeshes=[];function createGround(map,origin,color){const g=new THREE.Mesh(new THREE.PlaneGeometry(70,70),mat(color));g.rotation.x=-Math.PI/2;g.position.copy(origin);g.receiveShadow=true;g.userData={type:'ground',map};scene.add(g);groundMeshes.push(g);return g}createGround('bozkir',MAPS.bozkir.origin,0x52614b);createGround('dungeon',MAPS.dungeon.origin,0x313634);createGround('pvp',MAPS.pvp.origin,0x594238);
function castle(origin){for(const x of [-8,8]){const t=box(3.2,6,3.2,0x66645d);t.position.set(origin.x+x,3,origin.z+15);scene.add(t)}const wall=box(13,4,2,0x595852);wall.position.set(origin.x,2,origin.z+15);scene.add(wall);const gate=box(4.2,3.2,2.3,0x2d2118);gate.position.set(origin.x,1.6,origin.z+14.8);scene.add(gate)}castle(MAPS.bozkir.origin);
function tree(x,z,o=MAPS.bozkir.origin){const trunk=box(.5,3,.5,0x4b3424);trunk.position.set(o.x+x,1.5,o.z+z);const crown=new THREE.Mesh(new THREE.ConeGeometry(2,4,7),mat(0x354735));crown.position.set(o.x+x,4.5,o.z+z);scene.add(trunk,crown)}for(let i=0;i<32;i++){const a=Math.random()*Math.PI*2,r=18+Math.random()*13;tree(Math.cos(a)*r,Math.sin(a)*r)}
function dungeonProps(){const o=MAPS.dungeon.origin;for(let z=-25;z<=25;z+=8){for(const x of [-17,17]){const p=box(2.3,5,2.3,0x464947);p.position.set(o.x+x,2.5,o.z+z);scene.add(p)}}for(let x=-16;x<=16;x+=8){const p=box(1.6,3.2,1.6,0x3d403e);p.position.set(o.x+x,1.6,o.z-25);scene.add(p)}}dungeonProps();
function pvpProps(){const o=MAPS.pvp.origin;for(let i=0;i<18;i++){const r=10+Math.random()*22,a=Math.random()*6.28;const rock=new THREE.Mesh(new THREE.DodecahedronGeometry(1+Math.random()*1.4),mat(0x4a342d));rock.position.set(o.x+Math.cos(a)*r,.6,o.z+Math.sin(a)*r);scene.add(rock)}}pvpProps();
const mobs=[],npcs=[],portals=[],worldLoot=[];function addMob(map,kind,name,level,x,z,opt={}){const m={map,kind,name,level,hp:opt.hp||90+level*28,maxHp:opt.hp||90+level*28,damage:opt.damage||10+level*5,speed:opt.speed||2.25,aggro:opt.aggro??false,range:opt.range||1.7,aggroRange:opt.aggroRange||8,exp:opt.exp||50+level*28,coins:opt.coins||10+level*7,boss:!!opt.boss,alive:true,respawnAt:0,lastHit:0,home:new THREE.Vector3(),mesh:mobModel(kind),attackState:'idle',attackImpactAt:0,attackEndAt:0,hitStunUntil:0,phase:Math.random()*6.28};const o=MAPS[map].origin;m.mesh.position.set(o.x+x,0,o.z+z);m.home.copy(m.mesh.position);m.mesh.userData.entity=m;m.mesh.traverse(c=>c.userData.entity=m);const tg=new THREE.Mesh(new THREE.RingGeometry(m.boss?.95:.62,m.boss?1.28:.86,28),new THREE.MeshBasicMaterial({color:0xff4f3c,transparent:true,opacity:.0,side:THREE.DoubleSide,depthWrite:false}));tg.rotation.x=-Math.PI/2;tg.position.y=.035;tg.visible=false;m.mesh.add(tg);m.telegraph=tg;const l=label(`${name} · Lv ${level}`,m.boss?'#ff8a73':'#e8c16c');l.position.y=kind==='skeleton'?3:2.35;m.mesh.add(l);m.label=l;if(m.boss)m.mesh.scale.multiplyScalar(1.35);scene.add(m.mesh);mobs.push(m);return m}
