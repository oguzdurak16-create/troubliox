rd.rotation.z=-.25;const guard=new THREE.Mesh(new THREE.BoxGeometry(.52,.09,.15),mat(0x8a6934,.28,.72));guard.position.set(.87,.92,-.15);guard.rotation.z=-.25;g.add(sword,guard);g.userData.sword=sword;g.userData.swordMat=swordMat;g.userData.swordGuard=guard;g.userData.swordBaseZ=sword.rotation.z;g.userData.parts={body,head,helm,leftLeg:l,rightLeg:r,leftArm:la,rightArm:ra,cape:cl,sword};g.userData.base={bodyY:body.position.y,headY:head.position.y,capeY:cl.position.y};return g}
function mobModel(kind){const g=new THREE.Group();if(kind==='skeleton'){const bone=mat(0xd7d2b9);const b=new THREE.Mesh(new THREE.BoxGeometry(.62,1.2,.35),bone);b.position.y=1.5;const h=new THREE.Mesh(new THREE.SphereGeometry(.32,10,8),bone);h.position.y=2.35;const l=box(.18,1,.2,0xc8c1a7);l.position.set(-.18,.55,0);const r=l.clone();r.position.x=.18;g.add(b,h,l,r)}else if(kind==='enemy'){g.add(warrior(0x5a2823,0x151010));g.scale.set(.85,.85,.85)}else{const col=kind==='boar'?0x4b3325:0x3e4141;const body=new THREE.Mesh(new THREE.BoxGeometry(1.4,.7,.65),mat(col));body.position.y=.75;const head=new THREE.Mesh(new THREE.BoxGeometry(.65,.62,.58),mat(col));head.position.set(0, .85,-.82);for(const x of [-.45,.45])for(const z of [-.25,.25]){const leg=box(.18,.65,.18,0x2d2925);leg.position.set(x,.32,z);g.add(leg)}g.add(body,head)}return g}
const player=warrior();player.position.set(0,0,7);player.rotation.y=Math.PI;scene.add(player);
const groundMeshes=[];function createGround(map,origin,color){const g=new THREE.Mesh(new THREE.PlaneGeometry(70,70),mat(color));g.rotation.x=-Math.PI/2;g.position.copy(origin);g.receiveShadow=true;g.userData={type:'ground',map};scene.add(g);groundMeshes.push(g);return g}createGround('bozkir',MAPS.bozkir.origin,0x52614b);createGround('dungeon',MAPS.dungeon.origin,0x313634);createGround('pvp',MAPS.pvp.origin,0x594238);
function castle(origin){for(const x of [-8,8]){const t=box(3.2,6,3.2,0x66645d);t.position.set(origin.x+x,3,origin.z+15);scene.add(t)}const wall=box(13,4,2,0x595852);wall.position.set(origin.x,2,origin.z+15);scene.add(wall);const gate=box(4.2,3.2,2.3,0x2d2118);gate.position.set(origin.x,1.6,origin.z+14.8);scene.add(gate)}castle(MAPS.bozkir.origin);
function tree(x,z,o=MAPS.bozkir.origin){const trunk=box(.5,3,.5,0x4b3424);trunk.position.set(o.x+x,1.5,o.z+z);const crown=new THREE.Mesh(new THREE.ConeGeometry(2,4,7),mat(0x354735));crown.position.set(o.x+x,4.5,o.z+z);scene.add(trunk,crown)}for(let i=0;i<32;i++){const a=Math.random()*Math.PI*2,r=18+Math.random()*13;tree(Math.cos(a)*r,Math.sin(a)*r)}
function dungeonProps(){const o=MAPS.dungeon.origin;for(let z=-25;z<=25;z+=8){for(const x of [-17,17]){const p=box(2.3,5,2.3,0x464947);p.position.set(o.x+x,2.5,o.z+z);scene.add(p)}}for(let x=-16;x<=16;x+=8){const p=box(1.6,3.2,1.6,0x3d403e);p.position.set(o.x+x,1.6,o.z-25);scene.add(p)}}dungeonProps();
function pvpProps(){const o=MAPS.pvp.origin;for(let i=0;i<18;i++){const r=10+Math.random()*22,a=Math.random()*6.28;const rock=new THREE.Mesh(new THREE.DodecahedronGeometry(1+Math.random()*1.4),mat(0x4a342d));rock.position.set(o.x+Math.cos(a)*r,.6,o.z+Math.sin(a)*r);scene.add(rock)}}pvpProps();
const mobs=[],npcs=[],portals=[],worldLoot=[];function addMob(map,kind,name,level,x,z,opt={}){const m={map,kind,name,level,hp:opt.hp||90+level*28,maxHp:opt.hp||90+level*28,damage:opt.damage||10+level*5,speed:opt.speed||2.25,aggro:opt.aggro??false,range:opt.range||1.7,aggroRange:opt.aggroRange||8,exp:opt.exp||50+level*28,coins:opt.coins||10+level*7,boss:!!opt.boss,alive:true,respawnAt:0,lastHit:0,home:new THREE.Vector3(),mesh:mobModel(kind),attackState:'idle',attackImpactAt:0,attackEndAt:0,hitStunUntil:0,phase:Math.random()*6.28};const o=MAPS[map].origin;m.mesh.position.set(o.x+x,0,o.z+z);m.home.copy(m.mesh.position);m.mesh.userData.entity=m;m.mesh.traverse(c=>c.userData.entity=m);const tg=new THREE.Mesh(new THREE.RingGeometry(m.boss?.95:.62,m.boss?1.28:.86,28),new THREE.MeshBasicMaterial({color:0xff4f3c,transparent:true,opacity:.0,side:THREE.DoubleSide,depthWrite:false}));tg.rotation.x=-Math.PI/2;tg.position.y=.035;tg.visible=false;m.mesh.add(tg);m.telegraph=tg;const l=label(`${name} · Lv ${level}`,m.boss?'#ff8a73':'#e8c16c');l.position.y=kind==='skeleton'?3:2.35;m.mesh.add(l);m.label=l;if(m.boss)m.mesh.scale.multiplyScalar(1.35);scene.add(m.mesh);mobs.push(m);return m}
for(let i=0;i<7;i++)addMob('bozkir','wolf','Bozkır Kurdu',2,13+(i%3)*3,-10+Math.floor(i/3)*4,{damage:24,aggroRange:7});for(let i=0;i<5;i++)addMob('bozkir','boar','Yaban Domuzu',3,-18+(i%3)*3,-12+Math.floor(i/3)*4,{damage:30,aggroRange:6});addMob('bozkir','wolf','Alfa Kurt',5,23,-18,{hp:520,damage:55,boss:true,exp:500,coins:180,aggroRange:9});
for(let i=0;i<9;i++)addMob('dungeon','skeleton','Karakuyu İskeleti',5,-12+(i%3)*7,-12+Math.floor(i/3)*7,{hp:260,damage:44});addMob('dungeon','skeleton','Karakuyu Muhafızı',9,0,-20,{hp:1300,damage:78,boss:true,exp:1300,coins:600});
for(let i=0;i<6;i++)addMob('pvp','enemy','Karşı Ulus Savaşçısı',7,-10+(i%3)*10,-10+Math.floor(i/3)*11,{hp:620,damage:62,exp:0,coins:0});
function addNpc(role,name,x,z){const o=MAPS.bozkir.origin,g=warrior(role==='guard'?0x656b63:0x6b5233,0x252119);g.scale.set(.75,.75,.75);g.position.set(o.x+x,0,o.z+z);const n={role,name,map:'bozkir',mesh:g};g.userData.entity=n;g.traverse(c=>c.userData.entity=n);const l=label(name,'#f2d56f');l.position.y=3.4;g.add(l);n.label=l;scene.add(g);npcs.push(n);return n}addNpc('quest','Karahisar Muhafızı',-4,10);addNpc('sundries','Sundries Merchant',3,10);addNpc('inn','Inn Hostess',6,8);addNpc('teleport','Teleport Ustası',-7,8);addNpc('blacksmith','Demirci Börü',0,7);
function addPortal(map,target,name,x,z,color=0x5aa6cf){const o=MAPS[map].origin,g=new THREE.Group();const ring=new THREE.Mesh(new THREE.TorusGeometry(1.35,.16,10,28),new THREE.MeshStandardMaterial({color,emissive:color,emissiveIntensity:.5}));ring.rotation.x=Math.PI/2;ring.position.y=.12;const beam=new THREE.Mesh(new THREE.CylinderGeometry(.9,.9,2.8,24,1,true),new THREE.MeshBasicMaterial({color,transparent:true,opacity:.13,side:THREE.DoubleSide}));beam.position.y=1.4;g.add(ring,beam);g.position.set(o.x+x,0,o.z+z);const p={map,target,name,mesh:g};g.userData.entity=p;g.traverse(c=>c.userData.entity=p);const l=label(name,'#75d7ff');l.position.y=2.7;g.add(l);scene.add(g);portals.push(p);return p}addPortal('bozkir','dungeon','Karakuyu Zindanı',-13,13,0x54a7d1);addPortal('bozkir','pvp','Kızıl Sınır PvP',13,13,0xd45a46);addPortal('dungeon','bozkir','Karahisar Dönüşü',0,22,0xd6a34d);addPortal('pvp','bozkir','Karahisar Dönüşü',0,22,0xd6a34d);
let currentMap='bozkir',target=null,moveTarget=null,pending=null;const keys={w:false,a:false,s:false,d:false,shift:false};const virtualAxis={x:0,y:0};let rotating=false,lastPX=0,lastPY=0,touchCamera=false,lastAttack=0,lastRegen=0;
const ray=new THREE.Raycaster(),mouse=new THREE.Vector2();
function isSafeZone(pos=player.position){if(currentMap!=='bozkir')return false;const o=MAPS.bozkir.origin;return pos.distanceTo(new THREE.Vector3(o.x,0,o.z+13))<11.5}
let pendingAttack=null;const effects=[];let cameraPos=new THREE.Vector3(),cameraLook=new THREE.Vector3();
function lerpAngle(a,b,t){let d=(b-a+Math.PI)%(Math.PI*2)-Math.PI;return a+d*t}
function setCombatState(name,until=0){state.combatState=name;state.stateUntil=until;ui.combatState.textContent=name.toUpperCase()}
function startAttackAnim(power=1,duration=520){const now=performance.now();state.attackAnimUntil=now+duration;state.attackAnimPower=power;state.attackStart=now;state.attackEnd=now+duration;setCombatState('attack',state.attackEnd)}
function spawnSlashFx(power=1){const geo=new THREE.RingGeometry(.75,1.28,28,1,-2.4,3.8),ma=new THREE.MeshBasicMaterial({color:0xffd77a,transparent:true,opacity:.72,side:THREE.DoubleSide,depthWrite:false,blending:THREE.AdditiveBlending}),fx=new THREE.Mesh(geo,ma);const fwd=new THREE.Vector3(Math.sin(player.rotation.y),0,Math.cos(player.rotation.y));fx.position.copy(player.position).addScaledVector(fwd,1.05);fx.position.y+=1.65;fx.rotation.y=player.rotation.y;fx.rotation.z=-.45;fx.scale.setScalar(power);scene.add(fx);effects.push({mesh:fx,life:.24,max:.24,type:'slash'})}
function spawnHitFx(pos,crit=false){for(let i=0;i<(crit?9:5);i++){const ma=new THREE.MeshBasicMaterial({color:crit?0xffef8b:0xff874d,transparent:true,opacity:.9,depthWrite:false}),m=new THREE.Mesh(new THREE.SphereGeometry(.045+(crit?.025:0),6,5),ma);m.position.copy(pos);m.position.y+=1.25+Math.random()*.8;scene.add(m);effects.push({mesh:m,life:.35+Math.random()*.18,max:.5,type:'particle',v:new THREE.Vector3((Math.random()-.5)*3,1+Math.random()*2,(Math.random()-.5)*3)})}}
function updateEffects(dt){for(let i=effects.length-1;i>=0;i--){const e=effects[i];e.life-=dt;if(e.type==='slash'){e.mesh.material.opacity=Math.max(0,e.life/e.max)*.72;e.mesh.scale.multiplyScalar(1+dt*1.8)}else{e.v.y-=6*dt;e.mesh.position.addScaledVector(e.v,dt);e.mesh.material.opacity=Math.max(0,e.life/e.max)}if(e.life<=0){scene.remove(e.mesh);e.mesh.geometry?.dispose?.();e.mesh.material?.dispose?.();effects.splice(i,1)}}}
function updateAttackAnim(now,dt){const p=player.userData.parts;if(!p)return;const base=player.userData.swordBaseZ??-.25;let la=0,ra=0,ll=0,rl=0,bodyY=0,bodyRot=0,swordZ=base,swordX=0;
const moving=state.moving,run=state.stamina>0&&(keys.shift||performance.now()<state.sprintUntil);
if(state.combatState==='dodge'&&now<state.dodgeUntil){const q=1-(state.dodgeUntil-now)/420;bodyRot=-.32*Math.sin(q*Math.PI);la=.45;ra=.45;swordZ=base-.45}
else if(state.combatState==='hit'&&now<state.hitStunUntil){bodyRot=.22;la=-.35;ra=-.5}
else if(now<state.attackAnimUntil){const q=Math.min(1,Math.max(0,(now-state.attackStart)/(state.attackEnd-state.attackStart||1)));const wind=q<.36?q/.36:(q-.36)/.64;const wave=q<.36?Math.sin(wind*Math.PI/2):Math.sin((1-wind)*Math.PI/2);ra=-1.35*wave*state.attackAnimPower;la=.25*wave;swordZ=base-1.95*wave*state.attackAnimPower;swordX=-.35*wave;bodyRot=-.15*wave}
else if(moving){const phase=now*(run?.016:.011);const a=Math.sin(phase)*(run?.7:.48);ll=a;rl=-a;la=-a*.72;ra=a*.72;bodyY=Math.abs(Math.sin(phase))*0.035}
else{const breathe=Math.sin(now*.0024)*.025;bodyY=breathe;la=.03;ra=-.03}
p.leftLeg.rotation.x=THREE.MathUtils.lerp(p.leftLeg.rotation.x,ll,.22);p.rightLeg.rotation.x=THREE.MathUtils.lerp(p.rightLeg.rotation.x,rl,.22);p.leftArm.rotation.x=THREE.MathUtils.lerp(p.leftArm.rotation.x,la,.22);p.rightArm.rotation.x=THREE.MathUtils.lerp(p.rightArm.rotation.x,ra,.22);p.body.rotation.x=THREE.MathUtils.lerp(p.body.rotation.x,bodyRot,.2);p.sword.rotation.z=THREE.MathUtils.lerp(p.sword.rotation.z,swordZ,.32);p.sword.rotation.x=THREE.MathUtils.lerp(p.sword.rotation.x,swordX,.25);p.body.position.y=player.userData.base.bodyY+bodyY;p.head.position.y=player.userData.base.headY+bodyY;p.cape.position.y=player.userData.base.capeY+bodyY*.5;
if(now>=state.stateUntil&&state.combatState!=='idle'&&state.combatState!=='run'){setCombatState(moving?'run':'idle',0)}}
function refreshWeaponVisual(){const w=state.weapon,p=player.userData;if(!p?.sword)return;const plus=w.plus||0;p.sword.scale.y=1+plus*.025;const rar=w.rarity||'common',col={common:0xc