roughness:.9,metalness:0,side:THREE.DoubleSide}));cloak.position.set(0,1.95,.36);cloak.rotation.x=.05;
const sword=createSwordAsset(opt.weaponStyle||'long',opt.accent||0x9a733a);sword.position.set(.84,1.56,-.15);sword.rotation.z=-.28;sword.rotation.x=-.05;const shield=opt.shield===false?null:createShieldAsset(opt.shieldColor||0x42505a,opt.accent||0x9a733a);if(shield){shield.scale.set(.78,.78,.78);shield.position.set(-.78,1.72,-.03);shield.rotation.y=Math.PI/2;shield.rotation.z=.12}
