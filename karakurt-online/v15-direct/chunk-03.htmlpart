function npcModel(role){if(role==='quest'){const g=warrior(0x56606a,0x6a1719,{accent:0xb48b46,shield:true,weaponStyle:'long'});const spear=new THREE.Group(),shaft=new THREE.Mesh(new THREE.CylinderGeometry(.035,.035,2.7,8),mat(0x4a301d,.78,.08)),tip=new THREE.Mesh(new THREE.ConeGeometry(.11,.42,8),new THREE.MeshStandardMaterial({color:0xcbd3d8,roughness:.2,metalness:.92}));shaft.position.y=1.35;tip.position.y=2.88;spear.add(shaft,tip);spear.position.set(.9,.25,.15);spear.rotation.z=-.1;g.add(spear);g.userData.npcProp=spear;return g}if(role==='sundries'){const g=warrior(0x6b5233,0x47311f,{accent:0x84633a,shield:false,weaponStyle:'short',beard:0x5a3d27});g.userData.sword.visible=false;const pack=box(.75,1,.35,0x6f4d2d);pack.position.set(0,1.9,.46);const pouch1=new THREE.Mesh(new THREE.SphereGeometry(.22,9,7),mat(0x8a6134,.86,.02));pouch1.position.set(.48,1.55,.2);const pouch2=pouch1.clone();pouch2.position.x=-.48;g.add(pack,pouch1,pouch2);return g}if(role==='inn'){const g=warrior(0x704e62,0x3d2436,{accent:0xb78b55,shield:false,weaponStyle:'short',beard:0x2d201a});g.userData.sword.visible=false;g.userData.parts.helm.visible=false;const apron=new THREE.Mesh(new THREE.PlaneGeometry(.75,1.05),new THREE.MeshStandardMaterial({color:0xd0b68c,roughness:.9,side:THREE.DoubleSide}));apron.position.set(0,1.72,-.34);apron.rotation.y=Math.PI;g.add(apron);return g}if(role==='teleport'){const g=warrior(0x344a5d,0x202948,{accent:0x6ec7ff,shield:false,weaponStyle:'short',beard:0x29313a});g.userData.sword.visible=false;g.userData.parts.helm.visible=false;const hood=new THREE.Mesh(new THREE.ConeGeometry(.46,.68,12),mat(0x24384a,.86,.08));hood.position.y=3.45;const staff=new THREE.Group(),rod=new THREE.Mesh(new THREE.CylinderGeometry(.04,.05,2.8,8),mat(0x47301f,.8,.05)),orb=new THREE.Mesh(new THREE.IcosahedronGeometry(.18,1),new THREE.MeshStandardMaterial({color:0x7edfff,emissive:0x2f94d8,emissiveIntensity:1.8,roughness:.25,metalness:.15}));rod.position.y=1.35;orb.position.y=2.9;staff.add(rod,orb);staff.position.set(.85,.25,.1);g.add(hood,staff);g.userData.npcProp=staff;g.userData.orb=orb;return g}if(role==='blacksmith'){const g=warrior(0x4a4b4b,0x291b16,{accent:0xb66c32,shield:false,weaponStyle:'broad',beard:0x2b1c14});g.userData.sword.visible=false;g.userData.parts.helm.visible=false;g.scale.x=1.08;const apron=new THREE.Mesh(new THREE.PlaneGeometry(.82,1.18),new THREE.MeshStandardMaterial({color:0x3a2418,roughness:.95,side:THREE.DoubleSide}));apron.position.set(0,1.72,-.35);apron.rotation.y=Math.PI;const hammer=new THREE.Group(),handle=new THREE.Mesh(new THREE.CylinderGeometry(.045,.05,1.2,8),mat(0x4d2e19,.82,.06)),head=new THREE.Mesh(new THREE.BoxGeometry(.52,.22,.26),new THREE.MeshStandardMaterial({color:0x71797b,roughness:.34,metalness:.82}));handle.position.y=.55;head.position.y=1.15;hammer.add(handle,head);hammer.position.set(.74,1.05,-.05);hammer.rotation.z=-.45;g.add(apron,hammer);g.userData.npcProp=hammer;return g}return warrior(0x646464,0x292929,{shield:false})}
function addNpc(role,name,x,z){const o=MAPS.bozkir.origin,g=npcModel(role);g.scale.multiplyScalar(.78);g.position.set(o.x+x,0,o.z+z);const n={role,name,map:'bozkir',mesh:g,phase:Math.random()*6.28};g.userData.entity=n;g.traverse(c=>c.userData.entity=n);const roleName={quest:'Muhafız',sundries:'Tüccar',inn:'Han',teleport:'Işınlayıcı',blacksmith:'Demirci'}[role]||'NPC';const l=label(`${name} · ${roleName}`,'#f2d56f');l.position.y=3.5;g.add(l);n.label=l;scene.add(g);npcs.push(n);return n}
function addTownProps(){const o=MAPS.bozkir.origin;const anvil=new THREE.Group(),base=new THREE.Mesh(new THREE.CylinderGeometry(.38,.46,.58,8),mat(0x343638,.45,.72)),top=new THREE.Mesh(new THREE.BoxGeometry(1,.22,.42),mat(0x636a6d,.32,.88));base.position.y=.29;top.position.y=.68;anvil.add(base,top);anvil.position.set(o.x+1.4,0,o.z+7.2);scene.add(anvil);const forge=new THREE.Group(),stone=box(1.1,1.1,1.1,0x3d3731),fire=new THREE.Mesh(new THREE.ConeGeometry(.32,.8,10),new THREE.MeshStandardMaterial({color:0xffa13b,emissive:0xff4a00,emissiveIntensity:2.1,transparent:true,opacity:.88}));stone.position.y=.55;fire.position.y=1.15;forge.add(stone,fire);forge.position.set(o.x-1.35,0,o.z+7.4);forge.userData.fire=fire;scene.add(forge);const stall=new THREE.Group(),counter=box(2.2,.75,.8,0x6f4b2d),roof=new THREE.Mesh(new THREE.BoxGeometry(2.6,.12,1.5),mat(0x7b5131,.84,.05));counter.position.y=.38;roof.position.y=2.35;for(const x of [-1,1]){const post=box(.1,2.2,.1,0x4b321f);post.position.set(x,1.25,0);stall.add(post)}stall.add(counter,roof);stall.position.set(o.x+3,0,o.z+11.3);scene.add(stall);const barrel=new THREE.Mesh(new THREE.CylinderGeometry(.38,.42,.9,12),mat(0x6c4728,.86,.08));barrel.position.set(o.x+6.9,.45,o.z+8.5);scene.add(barrel);const rune=new THREE.Mesh(new THREE.TorusGeometry(.8,.06,10,28),new THREE.MeshStandardMaterial({color:0x6edcff,emissive:0x2b8bc1,emissiveIntensity:1.6,transparent:true,opacity:.8}));rune.position.set(o.x-7,1.6,o.z+7.6);rune.rotation.x=Math.PI/2;rune.userData.roleRune=true;scene.add(rune);scene.userData.townForge=forge;scene.userData.townRune=rune}
addNpc('quest','Karahisar Muhafızı',-4,10);addNpc('sundries','Sundries Merchant',3,10);addNpc('inn','Inn Hostess',6,8);addNpc('teleport','Teleport Ustası',-7,8);addNpc('blacksmith','Demirci Börü',0,7);addTownProps();
function addPortal(map,target,name,x,z,color=0x5aa6cf){const o=MAPS[map].origin,g=new THREE.Group();const ring=new THREE.Mesh(new THREE.TorusGeometry(1.35,.16,10,28),new THREE.MeshStandardMaterial({color,emissive:color,emissiveIntensity:.5}));ring.rotation.x=Math.PI/2;ring.position.y=.12;const beam=new THREE.Mesh(new THREE.CylinderGeometry(.9,.9,2.8,24,1,true),new THREE.MeshBasicMaterial({color,transparent:true,opacity:.13,side:THREE.DoubleSide}));beam.position.y=1.4;g.add(ring,beam);g.position.set(o.x+x,0,o.z+z);const p={map,target,name,mesh:g};g.userData.entity=p;g.traverse(c=>c.userData.entity=p);const l=label(name,'#75d7ff');l.position.y=2.7;g.add(l);scene.add(g);portals.push(p);return p}addPortal('bozkir','dungeon','Karakuyu Zindanı',-13,13,0x54a7d1);addPortal('bozkir','pvp','Kızıl Sınır PvP',13,13,0xd45a46);addPortal('dungeon','bozkir','Karahisar Dönüşü',0,22,0xd6a34d);addPortal('pvp','bozkir','Karahisar Dönüşü',0,22,0xd6a34d);
