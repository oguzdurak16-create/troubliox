size:12px!important}
.inventory,.equip-panel,.editor,.dialog{border:0!important;background:#06100df5!important;box-shadow:0 12px 36px #000c!important}.inventory{width:min(320px,58vw)!important}.invgrid{gap:4px!important}.invslot{font-size:7px!important}.invslot .ico{font-size:16px!important}.gear-row{margin:5px!important;padding:6px!important}.equip-panel{width:min(285px,54vw)!important}.upgrade-banner{top:24%;font-size:11px;padding:9px 14px}
}
</style><style id="v15-clean">
.item-detail{position:absolute;z-index:90;right:390px;bottom:96px;width:210px;padding:12px;display:none;text-align:center}.item-detail.open{display:block}.detail-close{position:absolute;right:5px;top:4px;border:0;background:transparent;font-size:18px}.detail-icon{font-size:34px;margin:7px}.compare{display:flex;justify-content:space-around;margin:10px 0;font-size:10px}.compare .good{color:#62df9e}.compare .bad{color:#ff7a6a}.detail-equip{width:100%;padding:8px;border:1px solid #4e8067;background:#0b2018;color:#8ce0b5}.loot-toast{position:absolute;z-index:35;left:50%;bottom:82px;transform:translateX(-50%);pointer-events:none}.upgradeInv{font-size:10px!important}
@media(pointer:coarse),(max-width:900px){.item-detail{right:calc(var(--safeR) + 6px)!important;bottom:calc(var(--safeB) + 58px)!important;width:min(210px,46vw)!important;border-radius:14px}.hotbar{pointer-events:none!important}.hotbar .slots,.hotbar .sidebtns{pointer-events:auto!important}.slots{filter:drop-shadow(0 5px 10px #0008)}.slot{background:radial-gradient(circle at 38% 28%,#26342eec,#07100ee8 72%)!important;border:1px solid #82957a66!important}.slot:nth-child(-n+4){transform:translateY(-3px)}.slot .icon{filter:drop-shadow(0 2px 2px #000)}.zone{opacity:.72}.minimap{opacity:.82}.player{opacity:.92}.combat button{backdrop-filter:blur(5px)}.combat #mr{box-shadow:0 5px 18px #000b,inset 0 0 13px #0009!important}.loot-toast{bottom:calc(var(--safeB) + 58px);font-size:8px}}
</style></head>
<body>
<div id="game">
  <div class="top"><div class="brand">KARAKURT ONLINE</div><div class="server"><span class="dot"></span>ALPHA · Browser MMORPG</div></div>
  <div id="playerHud" class="player glass"><div class="player-head"><b id="pname">Karakurt</b><span>Lv <b id="lvl">1</b> · Warrior · NP <b id="np">0</b></span></div><div class="meter hp"><i id="hpFill"></i><em id="hpText"></em></div><div class="meter mp"><i id="mpFill"></i><em id="mpText"></em></div><div class="meter stam"><i id="stamFill"></i><em id="stamText"></em></div></div>
  <div id="targetHud" class="target glass hidden"><div class="row"><b id="tname">Hedef</b><span id="tlevel">Lv 1</span></div><div class="bar"><i id="thp"></i></div></div>
  <div id="zone" class="zone safe">KARAHİSAR · GÜVENLİ BÖLGE</div>
  <div class="minimap glass"><b id="mapName">Bozkır Geçidi</b><div id="mini" class="map"><i class="mini-you"></i><i class="mini-mob" style="left:67%;top:38%"></i><i class="mini-mob" style="left:75%;top:55%"></i><i class="mini-npc" style="left:35%;top:68%"></i></div></div>
  <div class="quest glass"><b>GÖREV</b><div id="questText">Karahisar Muhafızı ile konuş. Sonra Bozkır'da 5 Kurt öldür.</div></div>
  <div id="message" class="msg">Sağ tık: kamera · Sol tık: yürü/etkileşim · Z: hedef · R: auto attack · SPACE: dodge · Loot: yaklaş/tıkla</div>
  <div id="chat" class="chat glass"><p><b>[System]</b> Karakurt Online'a hoş geldin.</p><p><b>[Party] Aybars:</b> Kurt slotu dolu mu?</p></div>
  <div class="hotbar"><div class="xp"><i id="xpFill"></i></div><div class="sidebtns"><button id="inventoryBtn" class="invbtn">ÇANTA (I)</button><button id="layoutBtn" class="layoutbtn">SKİLL</button></div><div id="autoInd" class="auto-ind">R: <b>KAPALI</b> · F: AFK <b>KAPALI</b></div><div id="slots" class="slots"></div><div class="money"><b id="coin">0</b>COIN · <span id="invCount">0</span> LOOT</div></div>
  <div id="editor" class="editor glass"><div class="editor-head"><b>SKILL DİZİLİMİ — önce slotu, sonra skilli seç</b><button id="editorClose">×</button></div><div id="skillpool" class="skillpool"></div></div>
  <div id="dialog" class="dialog glass"><header><b id="dialogTitle">NPC</b><button id="dialogClose">×</button></header><div id="dialogBody" class="body"></div></div>
  <div id="safeBadge" class="safe-badge">SAFE ZONE · COMBAT KAPALI</div><div id="comboHud" class="combo-hud">COMBO x1</div><div id="combatState" class="combat-state">IDLE</div>
  <div id="inventory" class="inventory glass"><header><b>ENVANTER</b><button id="inventoryClose">×</button></header><div class="invbody"><div id="invMeta" class="invmeta"></div><div id="invGrid" class="invgrid"></div></div></div>
  <button id="fullscreenBtn" class="fullscreen-btn mobile">⛶ <small>TAM EKRAN</small></button>
  <div id="joystick" class="joystick mobile"><div id="joystickKnob" class="joystick-knob"></div></div>
  <div class="mobile dpad"><button class="u" data-move="w">▲</button><button class="l" data-move="a">◀</button><button class="d" data-move="s">▼</button><button class="r" data-move="d">▶</button></div>
  <div class="mobile combat"><button id="mz">Z<br><small>HEDEF</small></button><button id="mr">R<br><small>AUTO</small></button><button id="mf">F<br><small>AFK</small></button><button id="mdodge">⤫<br><small>DODGE</small></button></div><div class="mobile camera-hint">Sağ tarafı sürükle: kamera</div>
  <div class="rotate-note">Karakurt Online mobilde yatay kullanım için tasarlandı.<br>Telefonu yatay çevir.</div>
  <div id="death" class="death"><div class="box glass"><h2>ÖLDÜN</h2><div>Karahisar'a dön ve tekrar hazırlan.</div><button id="respawn">ŞEHİRDE DOĞ</button></div></div>
</div>
<script type="module">
let THREE;try{THREE=await import('https://cdn.jsdelivr.net/npm/three@0.185.0/build/three.module.js')}catch(e){THREE=await import('https://unpkg.com/three@0.185.0/build/three.module.js')}
const $=s=>document.querySelector(s), game=$('#game');
const ui={hp:$('#hpFill'),hpText:$('#hpText'),mp:$('#mpFill'),mpText:$('#mpText'),lvl:$('#lvl'),np:$('#np'),target:$('#targetHud'),tname:$('#tname'),tlevel:$('#tlevel'),thp:$('#thp'),zone:$('#zone'),mapName:$('#mapName'),mini:$('#mini'),msg:$('#message'),chat:$('#chat'),xp:$('#xpFill'),coin:$('#coin'),inv:$('#invCount'),slots:$('#slots'),editor:$('#editor'),pool:$('#skillpool'),dialog:$('#dialog'),dialogTitle:$('#dialogTitle'),dialogBody:$('#dialogBody'),death:$('#death'),auto:$('#autoInd'),inventory:$('#inventory'),invGrid:$('#invGrid'),invMeta:$('#invMeta'),safeBadge:$('#safeBadge'),stam:$('#stamFill'),stamText:$('#stamText'),combo:$('#comboHud'),combatState:$('#combatState')};
const MAPS={bozkir:{name:'Karahisar · Bozkır Geçidi',origin:new THREE.Vector3(0,0,0)},dungeon:{name:'Karakuyu Zindanı',origin:new THREE.Vector3(150,0,0)},pvp:{name:'Kızıl Sınır · PvP',origin:new THREE.Vector3(-150,0,0)}};
const skills={slash:{n:'Keskin Darbe',s:'Darbe',i:'⚔️',mp:5,cd:900,pow:1.35},thrust:{n:'Delici Vuruş',s:'Delici',i:'🗡️',mp:12,cd:2200,pow:1.8},cleave:{n:'Yarma',s:'Yarma',i:'💥',mp:22,cd:4800,pow:1.15,aoe:true},dash:{n:'Hamle',s:'Hamle',i:'💨',mp:8,cd:5500,dash:true},potion:{n:'Can İksiri',s:'İksir',i:'🧪',mp:0,cd:1500,heal:240},guard:{n:'Çelik Muhafız',s:'Guard',i:'🛡️',mp:18,cd:12000,guard:true},provoke:{n:'Meydan Okuma',s:'Provoke',i:'📣',mp:10,cd:8000,provoke:true},sprint:{n:'Savaş Koşusu',s:'Sprint',i:'👣',mp:12,cd:10000,sprint:true}};
let bar=JSON.parse(localStorage.getItem('karakurt-bar')||'null')||['slash','thrust','cleave','dash','potion','guard','provoke','sprint'];let editSlot=null,cooldowns={};
const state={map:'bozkir',hp:620,maxHp:620,mp:190,maxMp:190,stamina:100,maxStamina:100,level:1,xp:0,nextXp:1200,coins:0,np:0,kills:0,loot:[],dead:false,auto:false,afk:false,guardUntil:0,sprintUntil:0,attackAnimUntil:0,attackAnimPower:0,combatState:'idle',stateUntil:0,invulnUntil:0,hitStunUntil:0,dodgeUntil:0,dodgeDir:new THREE.Vector3(),combo:0,comboUntil:0,attackStart:0,attackEnd:0,screenShake:0,moving:false,weapon:{name:'Bozkır Kılıcı',plus:0,atk:12,rarity:'common'},upgradeStones:5,upgradeFxUntil:0,afkPotionAt:0,potions:20,autoPotionThreshold:.55,equipment:{helmet:null,armor:null,boots:null,ring:null},lastSaveAt:0,selectedUpgrade:null,lootHintUntil:0};
const scene=new THREE.Scene();scene.background=new THREE.Color(0x72807a);scene.fog=new THREE.FogExp2(0x69736c,.015);
const camera=new THREE.PerspectiveCamera(58,innerWidth/innerHeight,.1,600);let cameraYaw=0,cameraPitch=.43,cameraDist=9;
const isMobile=matchMedia('(pointer:coarse)').matches||innerWidth<900;const renderer=new THREE.WebGLRenderer({antialias:!isMobile,powerPreference:isMobile?'default':'high-performance',alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,isMobile?1.7:1.8));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.06;renderer.setSize(innerWidth,innerHeight);renderer.setClearColor(0x72807a,1);renderer.shadowMap.enabled=!isMobile;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.domElement.style.cssText='position:absolute;inset:0;z-index:0;width:100%;height:100%;display:block;touch-action:none';game.prepend(renderer.domElement);renderer.domElement.addEventListener('webglcontextlost',e=>{e.preventDefault();message('3D görüntü bağlamı yenileniyor…');setTimeout(()=>location.reload(),500)});
scene.add(new THREE.HemisphereLight(0xcfe3ff,0x4a3527,1.8));const sun=new THREE.DirectionalLight(0xffe1aa,2.1);sun.position.set(-22,35,18);sun.castShadow=true;sun.shadow.mapSize.set(1024,1024);scene.add(sun);
const mat=(c,r=.8,m=0)=>new THREE.MeshStandardMaterial({color:c,roughness:r,metalness:m});
const box=(w,h,d,c)=>new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat(c));
function label(text,color='#f1d18b'){const c=document.createElement('canvas');c.width=512;c.height=80;const x=c.getContext('2d');x.fillStyle='#030606cc';x.fillRect(8,12,496,56);x.strokeStyle='#aa7b39';x.strokeRect(8,12,496,56);x.fillStyle=color;x.font='bold 27px Arial';x.textAlign='center';x.textBaseline='middle';x.fillText(text,256,40);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;const s=new THREE.Sprite(new THREE.SpriteMaterial({map:t,transparent:true,depthWrite:false}));s.scale.set(5.8,.9,1);return s}
function warrior(color=0x3f4b54,cape=0x6a1719){const g=new THREE.Group(),armor=mat(color,.45,.35),skin=mat(0xbd835f),leather=mat(0x332317);const body=new THREE.Mesh(new THREE.BoxGeometry(1.05,1.5,.55),armor);body.position.y=2.05;const head=new THREE.Mesh(new THREE.SphereGeometry(.35,12,10),skin);head.position.y=3.13;const helm=new THREE.Mesh(new THREE.ConeGeometry(.43,.65,8),armor);helm.position.y=3.48;const l=box(.32,1.15,.36,0x292d30);l.position.set(-.27,.68,0);const r=l.clone();r.position.x=.27;const la=box(.28,1.15,.32,0x343b40);la.position.set(-.7,2,0);const ra=la.clone();ra.position.x=.7;const cl=box(.9,1.55,.1,cape);cl.position.set(0,1.92,.35);g.add(body,head,helm,l,r,la,ra,cl);const swordMat=new THREE.MeshStandardMaterial({color:0xc8ced0,roughness:.22,metalness:.92,emissive:0x000000,emissiveIntensity:0});const sword=new THREE.Mesh(new THREE.BoxGeometry(.13,1.95,.09),swordMat);sword.position.set(.87,1.72,-.15);swo