id{gap:4px!important}.invslot{font-size:7px!important}.invslot .ico{font-size:16px!important}.gear-row{margin:5px!important;padding:6px!important}.equip-panel{width:min(285px,54vw)!important}.upgrade-banner{top:24%;font-size:11px;padding:9px 14px}}</style><style id="v15-clean">.item-detail{position:absolute;z-index:90;right:390px;bottom:96px;width:210px;padding:12px;display:none;text-align:center}.item-detail.open{display:block}.detail-close{position:absolute;right:5px;top:4px;border:0;background:transparent;font-size:18px}.detail-icon{font-size:34px;margin:7px}.compare{display:flex;justify-content:space-around;margin:10px 0;font-size:10px}.compare .good{color:#62df9e}.compare .bad{color:#ff7a6a}.detail-equip{width:100%;padding:8px;border:1px solid #4e8067;background:#0b2018;color:#8ce0b5}.loot-toast{position:absolute;z-index:35;left:50%;bottom:82px;transform:translateX(-50%);pointer-events:none}.upgradeInv{font-size:10px!important}@media(pointer:coarse),(max-width:900px){.item-detail{right:calc(var(--safeR) + 6px)!important;bottom:calc(var(--safeB) + 58px)!important;width:min(210px,46vw)!important;border-radius:14px}.hotbar{pointer-events:none!important}.hotbar .slots,.hotbar .sidebtns{pointer-events:auto!important}.slots{filter:drop-shadow(0 5px 10px #0008)}.slot{background:radial-gradient(circle at 38% 28%,#26342eec,#07100ee8 72%)!important;border:1px solid #82957a66!important}.slot:nth-child(-n+4){transform:translateY(-3px)}.slot .icon{filter:drop-shadow(0 2px 2px #000)}.zone{opacity:.72}.minimap{opacity:.82}.player{opacity:.92}.combat button{backdrop-filter:blur(5px)}.combat #mr{box-shadow:0 5px 18px #000b,inset 0 0 13px #0009!important}.loot-toast{bottom:calc(var(--safeB) + 58px);font-size:8px}}</style><style id="v16-assets">.interact-btn{display:none}@media(pointer:coarse),(max-width:900px){.interact-btn{position:absolute;z-index:58;right:calc(var(--safeR) + 98px);bottom:calc(var(--safeB) + 126px);width:54px;height:54px;border-radius:50%;border:1px solid #7ed9b3aa;background:radial-gradient(circle at 40% 30%,#1f4435dd,#07110ee8 68%);color:#9ee7c7;box-shadow:0 4px 18px #000a;display:none;align-items:center;justify-content:center;flex-direction:column;font-size:18px;line-height:1;backdrop-filter:blur(5px)}.interact-btn.on{display:flex}.interact-btn small{font-size:5.5px;margin-top:4px;letter-spacing:.08em}.interact-btn.portal{border-color:#73cfffaa;color:#8cddff;background:radial-gradient(circle at 40% 30%,#173746dd,#071018e8 68%)}.npc-role-pill{position:absolute;z-index:22;pointer-events:none;padding:3px 7px;border-radius:999px;background:#06100dcc;border:1px solid #4f6d5e88;color:#a6d7bf;font-size:7px;opacity:0;transition:.12s}.npc-role-pill.on{opacity:1}}</style><!----></head><body><div id="game"><div class="top"><div class="brand">KARAKURT ONLINE</div><div class="server"><span class="dot"></span>ALPHA · Browser MMORPG</div></div><div id="playerHud" class="player glass"><div class="player-head"><b id="pname">Karakurt</b><span>Lv <b id="lvl">1</b> · Warrior · NP <b id="np">0</b></span></div><div class="meter hp"><i id="hpFill"></i><em id="hpText"></em></div><div class="meter mp"><i id="mpFill"></i><em id="mpText"></em></div><div class="meter stam"><i id="stamFill"></i><em id="stamText"></em></div></div><div id="targetHud" class="target glass hidden"><div class="row"><b id="tname">Hedef</b><span id="tlevel">Lv 1</span></div><div class="bar"><i id="thp"></i></div></div><div id="zone" class="zone safe">KARAHİSAR · GÜVENLİ BÖLGE</div><div class="minimap glass"><b id="mapName">Bozkır Geçidi</b><div id="mini" class="map"><i class="mini-you"></i><i class="mini-mob" style="left:67%;top:38%"></i><i class="mini-mob" style="left:75%;top:55%"></i><i class="mini-npc" style="left:35%;top:68%"></i></div></div><div class="quest glass"><b>GÖREV</b><div id="questText">Karahisar Muhafızı ile konuş. Sonra Bozkır'da 5 Kurt öldür.</div></div><div id="message" class="msg">Sağ tık: kamera · Sol tık: yürü/etkileşim · Z: hedef · R: auto · SPACE: dodge</div><div id="chat" class="chat glass"><p><b>[System]</b> Karakurt Online'a hoş geldin.</p><p><b>[Party] Aybars:</b> Kurt slotu dolu mu?</p></div><div class="hotbar"><div class="xp"><i id="xpFill"></i></div><div class="sidebtns"><button id="inventoryBtn" class="invbtn">ÇANTA (I)</button><button id="layoutBtn" class="layoutbtn">SKİLL</button></div><div id="autoInd" class="auto-ind">R: <b>KAPALI</b> · F: AFK <b>KAPALI</b></div><div id="slots" class="slots"></div><div class="money"><b id="coin">0</b>COIN · <span id="invCount">0</span> LOOT</div></div><div id="editor" class="editor glass"><div class="editor-head"><b>SKILL DİZİLİMİ — önce slotu, sonra skilli seç</b><button id="editorClose">×</button></div><div id="skillpool" class="skillpool"></div></div><div id="dialog" class="dialog glass"><header><b id="dialogTitle">NPC</b><button id="dialogClose">×</button></header><div id="dialogBody" class="body"></div></div><div id="safeBadge" class="safe-badge">SAFE ZONE · COMBAT KAPALI</div><div id="comboHud" class="combo-hud">COMBO x1</div><div id="combatState" class="combat-state">IDLE</div><div id="inventory" class="inventory glass"><header><b>ENVANTER</b><button id="inventoryClose">×</button></header><div class="invbody"><div id="invMeta" class="invmeta"></div><div id="invGrid" class="invgrid"></div></div></div><button id="fullscreenBtn" class="fullscreen-btn mobile">⛶ <small>TAM EKRAN</small></button><div id="joystick" class="joystick mobile"><div id="joystickKnob" class="joystick-knob"></div></div><div class="mobile dpad"><button class="u" data-move="w">▲</button><button class="l" data-move="a">◀</button><button class="d" data-move="s">▼</button><button class="r" data-move="d">▶</button></div><div class="mobile combat"><button id="mz">Z<br><small>HEDEF</small></button><button id="mr">R<br><small>AUTO</small></button><button id="mf">F<br><small>AFK</small></button><button id="mdodge">⤫<br><small>DODGE</small></button></div><div class="mobile camera-hint">Sağ tarafı sürükle: kamera</div><button id="interactBtn" class="interact-btn mobile">✦<small>ETKİLEŞİM</small></button><div class="rotate-note">Karakurt Online mobilde yatay kullanım için tasarlandı.<br>Telefonu yatay çevir.</div><div id="death" class="death"><div class="box glass"><h2>ÖLDÜN</h2><div>Karahisar'a dön ve tekrar hazırlan.</div><button id="respawn">ŞEHİRDE DOĞ</button></div></div></div><script type="module">let e;try{e=await(import("https://cdn.jsdelivr.net/npm/three@0.185.0/build/three.module.js"))}catch(t){e=await(import("https://unpkg.com/three@0.185.0/build/three.module.js"))}const t=e=>document.querySelector(e),n=t("#game"),o={hp:t("#hpFill"),hpText:t("#hpText"),mp:t("#mpFill"),mpText:t("#mpText"),lvl:t("#lvl"),np:t("#np"),target:t("#targetHud"),tname:t("#tname"),tlevel:t("#tlevel"),thp:t("#thp"),zone:t("#zone"),mapName:t("#mapName"),mini:t("#mini"),msg:t("#message"),chat:t("#chat"),xp:t("#xpFill"),coin:t("#coin"),inv:t("#invCount"),slots:t("#slots"),editor:t("#editor"),pool:t("#skillpool"),dialog:t("#dialog"),dialogTitle:t("#dialogTitle"),dialogBody:t("#dialogBody"),death:t("#death"),auto:t("#autoInd"),inventory:t("#inventory"),invGrid:t("#invGrid"),invMeta:t("#invMeta"),safeBadge:t("#safeBadge"),stam:t("#stamFill"),stamText:t("#stamText"),combo:t("#comboHud"),combatState:t("#combatState")},a={bozkir:{name:"Karahisar · Bozkır Geçidi",origin:new e.Vector3(0,0,0)},dungeon:{name:"Karakuyu Zindanı",origin:new e.Vector3(150,0,0)},pvp:{name:"Kızıl Sınır · PvP",origin:new e.Vector3(-150,0,0)}},i={slash:{n:"Keskin Darbe",s:"Darbe",i:"⚔️",mp:5,cd:900,pow:1.35},thrust:{n:"Delici Vuruş",s:"Delici",i:"🗡️",mp:12,cd:2200,pow:1.8},cleave:{n:"Yarma",s:"Yarma",i:"💥",mp:22,cd:4800,pow:1.15,aoe:!0},dash:{n:"Hamle",s:"Hamle",i:"💨",mp:8,cd:5500,dash:!0},potion:{n:"Can İksiri",s:"İksir",i:"🧪",mp:0,cd:1500,heal:240},guard:{n:"Çelik Muhafız",s:"Guard",i:"🛡️",mp:18,cd:12e3,guard:!0},provoke:{n:"Meydan Okuma",s:"Provoke",i:"📣",mp:10,cd:8e3,provoke:!0},sprint:{n:"Savaş Koşusu",s:"Sprin