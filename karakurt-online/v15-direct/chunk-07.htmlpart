`;const raw=atob(b.replace(/\s/g,'')),u=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)u[i]=raw.charCodeAt(i);if(typeof DecompressionStream==='undefined')throw Error('Tarayıcı gzip açmayı desteklemiyor');const html=await new Response(new Blob([u]).stream().pipeThrough(new DecompressionStream('gzip'))).text();if(!html.includes('Browser MMORPG v16'))throw Error('v16 motor doğrulaması başarısız');document.open();document.write(html);document.close()}catch(e){document.getElementById('boot').innerHTML='Açılış hatası: '+e+'<br><button onclick="location.reload()" style="margin-top:14px;padding:10px 14px">TEKRAR DENE</button>'}})()</script>