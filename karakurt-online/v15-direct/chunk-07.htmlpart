{targetNearest();e.preventDefault()}if(k==='r'){toggleAuto();e.preventDefault()}if(k==='f'){toggleAfk();e.preventDefault()}if(k==='i'){toggleInventory();e.preventDefault()}if(/^[1-8]$/.test(k)){useSkill(+k-1);e.preventDefault()}});addEventListener('keyup',e=>{const k=e.key.toLowerCase();if(keys[k]!==undefined)keys[k]=false;if(k==='shift')keys.shift=false});
const fsBtn=$('#fullscreenBtn'),joy=$('#joystick'),joyKnob=$('#joystickKnob');
function setFsLabel(){const fs=!!(document.fullscreenElement||document.webkitFullscreenElement);fsBtn.innerHTML=fs?'⛶ <small>ÇIKIŞ</small>':'⛶ <small>TAM EKRAN</small>';document.body.classList.toggle('pseudo-fullscreen',fs||document.body.classList.contains('pseudo-fullscreen'))}
async function toggleFullscreen(){
  const root=document.documentElement,fs=document.fullscreenElement||document.webkitFullscreenElement;
  try{
    if(fs){const exit=document.exitFullscreen||document.webkitExitFullscreen;if(exit)await exit.call(document);document.body.classList.remove('pseudo-fullscreen');setFsLabel();return}
    const req=root.requestFullscreen||root.webkitRequestFullscreen;
    if(req){await req.call(root,{navigationUI:'hide'}).catch(()=>req.call(root));document.body.classList.add('pseudo-fullscreen');try{await screen.orientation?.lock?.('landscape')}catch{};setFsLabel();return}
  }catch{}
  document.body.classList.add('pseudo-fullscreen');window.scrollTo(0,1);setFsLabel();message('iPhone Safari tam ekranı sınırlıyorsa Paylaş → Ana Ekrana Ekle ile tarayıcı çubuksuz açılır.');
}
fsBtn?.addEventListener('click',toggleFullscreen);document.addEventListener('fullscreenchange',setFsLabel);document.addEventListener('webkitfullscreenchange',setFsLabel);
let joyPointer=null;
function updateJoy(e){const r=joy.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2;let dx=e.clientX-cx,dy=e.clientY-cy;const max=34,len=Math.hypot(dx,dy)||1;if(len>max){dx=dx/len*max;dy=dy/len*max}virtualAxis.x=dx/max;virtualAxis.y=dy/max;joyKnob.style.transform=`translate(${dx}px,${dy}px)`}
function resetJoy(){joyPointer=null;virtualAxis.x=virtualAxis.y=0;joyKnob.style.transform='translate(0,0)'}
joy?.addEventListener('pointerdown',e=>{e.preventDefault();joyPointer=e.pointerId;joy.setPointerCapture?.(e.pointerId);updateJoy(e)});joy?.addEventListener('pointermove',e=>{if(e.pointerId===joyPointer){e.preventDefault();updateJoy(e)}});joy?.addEventListener('pointerup',e=>{if(e.pointerId===joyPointer)resetJoy()});joy?.addEventListener('pointercancel',resetJoy);
for(const b of document.querySelectorAll('[data-move]')){const k=b.dataset.move;const on=e=>{e.preventDefault();keys[k]=true},off=e=>{e.preventDefault();keys[k]=false};b.addEventListener('pointerdown',on);b.addEventListener('pointerup',off);b.addEventListener('pointercancel',off)}$('#mz').onclick=targetNearest;$('#mr').onclick=toggleAuto;$('#mf').onclick=toggleAfk;$('#mdodge').onclick=dodge;$('#respawn').onclick=respawn;$('#inventoryBtn').onclick=()=>toggleInventory();$('#inventoryClose').onclick=()=>toggleInventory(false);$('#layoutBtn').onclick=()=>{editSlot=0;ui.editor.classList.add('open');renderSlots()};$('#editorClose').onclick=()=>{editSlot=null;ui.editor.classList.remove('open');renderSlots()};$('#dialogClose').onclick=()=>ui.dialog.classList.remove('open');
function updatePlayer(dt){if(state.dead)return;const now=performance.now(),view=new THREE.Vector3(Math.sin(cameraYaw),0,-Math.cos(cameraYaw)),right=new THREE.Vector3(Math.cos(cameraYaw),0,Math.sin(cameraYaw));if(now<state.dodgeUntil){player.position.addScaledVector(state.dodgeDir,10.5*dt);state.moving=true}else if(now<state.hitStunUntil){state.moving=false}else{const dir=new THREE.Vector3();if(keys.w)dir.add(view);if(keys.s)dir.sub(view);if(keys.d)dir.add(right);if(keys.a)dir.sub(right);if(Math.abs(virtualAxis.y)>.06)dir.addScaledVector(view,-virtualAxis.y);if(Math.abs(virtualAxis.x)>.06)dir.addScaledVector(right,virtualAxis.x);let moving=dir.lengthSq()>0;state.moving=moving;
if(moving&&state.combatState!=='attack'){moveTarget=null;pending=null;if(!state.afk)state.auto=false;dir.normalize();let sprint=(keys.shift||now<state.sprintUntil)&&state.stamina>1;if(sprint){state.stamina=Math.max(0,state.stamina-24*dt)}const sp=sprint?7.3:4.6;player.position.addScaledVector(dir,sp*dt);player.rotation.y=lerpAngle(player.rotation.y,Math.atan2(dir.x,dir.z),.35);setCombatState(sprint?'sprint':'run')}
else if(moveTarget&&state.combatState!=='attack'){dir.copy(moveTarget).sub(player.position).setY(0);const d=dir.length();if(d>.25){dir.normalize();const sp=4.5;player.position.addScaledVector(dir,Math.min(d,sp*dt));player.rotation.y=lerpAngle(player.rotation.y,Math.atan2(dir.x,dir.z),.35);state.moving=true;setCombatState('run')}else{moveTarget=null;state.moving=false;if(pending){const p=pending;pending=null;interact(p)}}}
else if(state.combatState==='run'||state.combatState==='sprint')setCombatState('idle')}
if(now>=state.dodgeUntil&&state.stamina<state.maxStamina){const regen=(state.moving?13:20)*dt;state.stamina=Math.min(state.maxStamina,state.stamina+regen)}const o=MAPS[currentMap].origin;player.position.x=Math.max(o.x-31,Math.min(o.x+31,player.position.x));player.position.z=Math.max(o.z-31,Math.min(o.z+31,player.position.z));for(const n of npcs){if(n.map!==currentMap)continue;const d=player.position.clone().sub(n.mesh.position).setY(0),len=d.length();if(len<1.0&&len>.001)player.position.addScaledVector(d.normalize(),(1.0-len))}for(const m of mobs){if(!m.alive||m.map!==currentMap)continue;const d=player.position.clone().sub(m.mesh.position).setY(0),len=d.length();if(len<.72&&len>.001)player.position.addScaledVector(d.normalize(),(.72-len)*.45)}}
function updateMobs(dt,now){const safe=isSafeZone();for(const m of mobs){if(!m.alive){if(now>=m.respawnAt){m.alive=true;m.hp=m.maxHp;m.aggro=false;m.attackState='idle';m.telegraph.visible=false;m.mesh.position.copy(m.home);m.mesh.visible=m.map===currentMap}continue}if(m.map!==currentMap)continue;const d=m.mesh.position.distanceTo(player.position),homeD=m.mesh.position.distanceTo(m.home);m.mesh.rotation.z=Math.sin(now*.006+m.phase)*.025;if(now<m.hitStunUntil){m.telegraph.visible=false;continue}
if(safe){m.aggro=false;m.attackState='idle';m.telegraph.visible=false;if(homeD>.15){const v=m.home.clone().sub(m.mesh.position).setY(0);m.mesh.position.addScaledVector(v.normalize(),Math.min(homeD,m.speed*dt))}continue}
if(m.attackState==='windup'){m.telegraph.visible=true;m.telegraph.material.opacity=.22+.28*Math.abs(Math.sin(now*.018));m.mesh.scale.y=1-.08*Math.sin(Math.min(1,(m.attackImpactAt-now+420)/420)*Math.PI);if(now>=m.attackImpactAt){m.attackState='recovery';m.telegraph.visible=false;m.mesh.scale.y=1;if(player.position.distanceTo(m.mesh.position)<=m.range+.45&&!state.dead&&!isSafeZone())damagePlayer(m.damage*(.82+Math.random()*.38),m.mesh.position)}continue}
if(m.attackState==='recovery'){m.telegraph.visible=false;if(now>=m.attackEndAt)m.attackState='idle';continue}
if(m.aggro&&d<14&&!state.dead){if(d>m.range){const next=m.mesh.position.clone().add(player.position.clone().sub(m.mesh.position).setY(0).normalize().multiplyScalar(m.speed*dt));if(!isSafeZone(next)){m.mesh.position.copy(next);m.mesh.lookAt(player.position.x,m.mesh.position.y,player.position.z)}else m.aggro=false}else if(now-m.lastHit>(m.boss?1450:1180)){m.lastHit=now;m.attackState='windup';const wind=m.boss?620:390;m.attackImpactAt=now+wind;m.attackEndAt=m.attackImpactAt+(m.boss?720:520);m.telegraph.visible=true}}
else if(m.aggroRange&&d<m.aggroRange&&!state.dead)m.aggro=true;else if(homeD>.2){const v=m.home.clone().sub(m.mesh.position).setY(0);m.mesh.position.addScaledVector(v.normalize(),Math.min(homeD,m.speed*.65*dt))}if(homeD>19){m.aggro=false;m.attackState='idle';m.telegraph.visible=false}}}
function updateCamera(){const view=new THREE.Vector3(Math.sin(cameraYaw),0,-Math.cos(cameraYaw)),behind=view.clone().multiplyScalar(-cameraDist),h=3.2+cameraPitch*5,desired=new THREE.Vector3(player.position.x+behind.x,player.position.y+h,player.position.z+behind.z),look=new THREE.Vector3(player.position.x,player.position.y+1.65,player.position.z);if(cameraPos.lengthSq()===0){cameraPos.copy(desired);cameraLook.copy(look)}cameraPos.lerp(desired,.16);cameraLook.lerp(look,.22);if(state.screenShake>.005){cameraPos.x+=(Math.random()-.5)*state.screenShake;cameraPos.y+=(Math.random()-.5)*state.screenShake;cameraPos.z+=(Math.random()-.5)*state.screenShake;state.screenShake*=.82}camera.position.copy(cameraPos);camera.lookAt(cameraLook);const targetFov=((keys.shift||performance.now()<state.sprintUntil)&&state.moving)?64:58;camera.fov=THREE.MathUtils.lerp(camera.fov,targetFov,.08);camera.updateProjectionMatrix()}
function updateZone(){const safe=isSafeZone();ui.safeBadge.classList.toggle('on',safe);if(safe){if(state.auto||state.afk){state.auto=false;state.afk=false;renderHud()}ui.zone.textContent='KARAHİSAR · GÜVENLİ BÖLGE';ui.zone.className='zone safe'}else if(currentMap==='pvp'){ui.zone.textContent='KIZIL SINIR · PvP AÇIK';ui.zone.className='zone pvp'}else{ui.zone.textContent=currentMap==='dungeon'?'KARAKUYU ZİNDANI · TEHLİKELİ':'BOZKIR AVCILIĞI · PvE';ui.zone.className='zone'} }
let prev=performance.now();function loop(now){const dt=Math.min(.04,(now-prev)/1000);prev=now;updatePlayer(dt);processPendingAttack(now);if(state.afk&&!state.dead&&currentMap!=='pvp'&&(!target||!target.alive)){const n=nearest(40);if(n){setTarget(n);state.auto=true}}if(state.afk&&!state.dead&&state.hp/state.maxHp<state.autoPotionThreshold&&now>state.afkPotionAt){const id='potion';if((cooldowns[id]||0)<=now&&state.potions>0){state.potions--;state.hp=Math.min(state.maxHp,state.hp+240);cooldowns[id]=now+1500;state.afkPotionAt=now+1450;spawnHitFx(player.position,false);sfx('pot');saveProgress();renderHud()}}if(state.auto)basicAttack();updateMobs(dt,now);updateWorldLoot(dt,now);if(now>state.comboUntil&&state.combo){state.combo=0;ui.combo.classList.remove('on')}if(now-lastRegen>250&&!state.dead){lastRegen=now;state.mp=Math.min(state.maxMp,state.mp+1);if(!target||!state.auto)state.hp=Math.min(state.maxHp,state.hp+.35);renderHud()}updateAttackAnim(now,dt);updateEffects(dt);updateCamera();updateZone();updateWorldLabels();if(now-state.lastSaveAt>5000){state.lastSaveAt=now;saveProgress()}if(target&&!target.alive)setTarget(null);if(now%200<20)renderSlots();renderer.render(scene,camera);requestAnimationFrame(loop)}
if(matchMedia('(display-mode: standalone)').matches||navigator.standalone){document.body.classList.add('pseudo-fullscreen');setFsLabel()}
addEventListener('pointerdown',ensureAudio,{once:false,passive:true});addEventListener('pagehide',saveProgress);addEventListener('visibilitychange',()=>{if(document.hidden)saveProgress()});addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);renderer.setPixelRatio(Math.min(devicePixelRatio,isMobile?1.7:1.8))});loadGear();loadProgress();renderSlots();renderPool();renderHud();syncVisibility();refreshWeaponVisual();refreshEquipmentVisual();initEquipmentUI();renderEquipment();requestAnimationFrame(loop);
</script>
</body></html>
