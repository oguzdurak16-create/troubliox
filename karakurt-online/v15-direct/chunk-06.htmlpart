nt=`COMBO x${state.combo}`;ui.combo.classList.add('on');lastAttack=now;const bonus=1+(state.combo-1)*.07;queueAttack(target,{tag:'R',damage:(30+Math.random()*18+state.level*3+state.weapon.atk+gearAttack())*bonus,windup:state.combo===3?135:175,recovery:state.combo===3?350:425,power:1+.12*state.combo,range:2.45})}
function useSkill(slot){if(state.dead||pendingAttack||performance.now()<state.hitStunUntil||performance.now()<state.dodgeUntil)return;const id=bar[slot],sk=skills[id];if(!sk)return;if(isSafeZone()&&!sk.heal&&!sk.guard&&!sk.sprint){message('Safe zone içinde saldırı skilleri kullanılamaz.');return}const now=performance.now();if((cooldowns[id]||0)>now)return;if(state.mp<sk.mp){message('Yetersiz MP.');return}
if(sk.heal){if(id==='potion'&&state.potions<=0){message('Can iksiri kalmadı.');return}if(id==='potion'){state.potions--;sfx('pot')}state.hp=Math.min(state.maxHp,state.hp+sk.heal);state.mp-=sk.mp;cooldowns[id]=now+sk.cd;saveProgress()}
else if(sk.guard){spawnSkillFx('guard',target);state.guardUntil=now+2500;state.mp-=sk.mp;cooldowns[id]=now+sk.cd;setCombatState('guard',now+600)}
else if(sk.sprint){state.sprintUntil=now+5500;state.stamina=Math.min(state.maxStamina,state.stamina+30);state.mp-=sk.mp;cooldowns[id]=now+sk.cd}
else if(sk.provoke){spawnSkillFx('provoke',target);mobs.forEach(m=>{if(m.map===currentMap&&m.alive&&m.mesh.position.distanceTo(player.position)<10)m.aggro=true});state.mp-=sk.mp;cooldowns[id]=now+sk.cd}
else if(sk.dash){spawnSkillFx('dash',target);if(!target){message('Önce hedef seç.');return}const dir=target.mesh.position.clone().sub(player.position).setY(0);if(dir.length()>1.9){dir.setLength(Math.max(0,dir.length()-1.7));player.position.add(dir)}state.mp-=sk.mp;cooldowns[id]=now+sk.cd}
else{if(!target||!target.alive){message('Önce Z ile hedef seç.');return}if(player.position.distanceTo(target.mesh.position)>2.7){message('Hedef menzil dışında.');return}state.mp-=sk.mp;cooldowns[id]=now+sk.cd;spawnSkillFx(id,target);const dmg=(38+Math.random()*16+state.level*4)*sk.pow;queueAttack(target,{tag:sk.n,damage:dmg,windup:sk.aoe?320:235,recovery:sk.aoe?620:480,power:sk.aoe?1.5:1.25,aoe:!!sk.aoe,range:2.8})}
renderHud();renderSlots()}
function renderHud(){ui.hp.style.width=(state.hp/state.maxHp*100)+'%';ui.hpText.textContent=`${Math.round(state.hp)} / ${state.maxHp}`;ui.mp.style.width=(state.mp/state.maxMp*100)+'%';ui.mpText.textContent=`${Math.round(state.mp)} / ${state.maxMp}`;ui.stam.style.width=(state.stamina/state.maxStamina*100)+'%';ui.stamText.textContent=`STA ${Math.round(state.stamina)} / ${state.maxStamina}`;ui.lvl.textContent=state.level;ui.np.textContent=state.np;ui.xp.style.width=(state.xp/state.nextXp*100)+'%';ui.coin.textContent=state.coins.toLocaleString('tr-TR');ui.inv.textContent=state.loot.length;ui.auto.innerHTML=`R: <b>${state.auto?'AÇIK':'KAPALI'}</b> · F: AFK <b>${state.afk?'AÇIK':'KAPALI'}</b>`;$('#mr').classList.toggle('on',state.auto);$('#mf').classList.toggle('on',state.afk);const afkSmall=$('#mf small');if(afkSmall)afkSmall.textContent=state.afk?`POT ${state.potions}`:'AFK';if(ui.inventory.classList.contains('open'))renderInventory();renderEquipment()}
function renderSlots(){ui.slots.innerHTML='';bar.forEach((id,i)=>{const s=skills[id],b=document.createElement('button');b.className='slot'+(editSlot===i?' active':'');b.draggable=true;b.dataset.i=i;b.innerHTML=`<kbd>${i+1}</kbd><span class="icon">${s.i}</span><small>${id==='potion'?`x${state.potions}`:s.s}</small>`;const rem=(cooldowns[id]||0)-performance.now();if(rem>0)b.innerHTML+=`<span class="cd">${(rem/1000).toFixed(1)}</span>`;b.onclick=()=>editSlot!==null?(editSlot=i,renderSlots()):useSkill(i);b.ondragstart=e=>e.dataTransfer.setData('text/plain',String(i));b.ondragover=e=>e.preventDefault();b.ondrop=e=>{e.preventDefault();const from=+e.dataTransfer.getData('text/plain'),to=i;[bar[from],bar[to]]=[bar[to],bar[from]];saveBar()};ui.slots.appendChild(b)})}
function saveBar(){localStorage.setItem('karakurt-bar',JSON.stringify(bar));renderSlots()}
function renderPool(){ui.pool.innerHTML='';Object.entries(skills).forEach(([id,s])=>{const b=document.createElement('button');b.innerHTML=`<b>${s.i} ${s.n}</b><small>MP ${s.mp} · CD ${(s.cd/1000).toFixed(1)}s</small>`;b.onclick=()=>{if(editSlot===null){message('Önce değiştireceğin skill slotuna tıkla.');return}bar[editSlot]=id;saveBar()};ui.pool.appendChild(b)})}
function itemIcon(item){const name=typeof item==='string'?item:item.name;if(typeof item==='object'&&item.kind==='gear')return item.slot==='weapon'?'⚔️':item.slot==='helmet'?'⛑️':item.slot==='armor'?'🛡️':item.slot==='boots'?'🥾':'💍';if(name.includes('Potion'))return'🧪';if(name.includes('Diş'))return'🦷';if(name.includes('Bronz'))return'🔩';if(name.includes('Kumaş'))return'🧵';return'📦'}
function showItemDetail(item,idx){let d=$('#itemDetail');if(!d){d=document.createElement('div');d.id='itemDetail';d.className='item-detail glass';game.appendChild(d)}if(!item){d.classList.remove('open');return}const gear=typeof item==='object'&&item.kind==='gear';let comp='';if(gear){const eq=item.slot==='weapon'?state.weapon:state.equipment[item.slot];const oldAtk=eq?.atk||0,oldDef=eq?.def||0;comp=`<div class="compare"><span>ATK ${item.atk||0} <b class="${(item.atk||0)>=oldAtk?'good':'bad'}">${(item.atk||0)-oldAtk>=0?'+':''}${(item.atk||0)-oldAtk}</b></span><span>DEF ${item.def||0} <b class="${(item.def||0)>=oldDef?'good':'bad'}">${(item.def||0)-oldDef>=0?'+':''}${(item.def||0)-oldDef}</b></span></div>`}const r=gear?rarityData[item.rarity||'common']:rarityData.common;d.innerHTML=`<button class="detail-close">×</button><div class="detail-icon">${itemIcon(item)}</div><b style="color:${r.c}">${typeof item==='string'?item:item.name}${gear&&item.plus?` +${item.plus}`:''}</b>${comp}${gear?`<button class="detail-equip">KUŞAN</button>`:''}`;d.classList.add('open');d.querySelector('.detail-close').onclick=()=>d.classList.remove('open');const e=d.querySelector('.detail-equip');if(e)e.onclick=()=>{equipItem(idx);d.classList.remove('open')}}
function renderInventory(){ui.invMeta.innerHTML=`<span>${state.loot.length}/24 · 🧪 ${state.potions}</span><span>${state.coins.toLocaleString('tr-TR')} coin</span>`;ui.invGrid.innerHTML='';for(let i=0;i<24;i++){const item=state.loot[i],d=document.createElement('div');d.className='invslot'+(item?' filled':'');if(item&&typeof item==='object'&&item.kind==='gear'){const r=rarityData[item.rarity||'common'];d.style.borderColor=r.c;d.style.color=r.c;d.innerHTML=`<span><b class="ico">${itemIcon(item)}</b>${item.name}<small>${item.atk?'ATK '+item.atk:'DEF '+item.def}</small></span>`;d.onclick=()=>showItemDetail(item,i);d.ondblclick=()=>equipItem(i)}else d.innerHTML=item?`<span><b class="ico">${itemIcon(item)}</b>${item}</span>`:'';ui.invGrid.appendChild(d)}}
function toggleInventory(force){const open=force??!ui.inventory.classList.contains('open');ui.inventory.classList.toggle('open',open);if(open)renderInventory()}
function npcDialog(n){ui.dialogTitle.textContent=n.name;let html='';if(n.role==='quest'){html=state.kills>=5?`<p>Bozkır temizlendi. Ödülün hazır.</p><button id="reward">Görev ödülünü al · 500 EXP · 250 coin</button>`:`<p>Karahisar'ın dışında kurtlar çoğaldı. 5 Bozkır Kurdu öldür. Şu an: ${state.kills}/5.</p>`}else if(n.role==='sundries')html=`<p>AFK için Can İksiri stokla.<br>Mevcut: <b>${state.potions}</b></p><button id="buyPot">50 coin · 5 Can İksiri</button>`;else if(n.role==='inn')html=`<p>Depodaki loot: ${state.loot.length} parça. Şimdilik prototip warehouse olarak saklanıyor.</p><button id="stash">Loot listesini temizle / depoya aktar</button>`;else if(n.role==='blacksmith'){const wp=state.weapon.plus||0,wc=upgradeCost(wp),gear=state.loot.map((x,i)=>({x,i})).filter(o=>o.x&&typeof o.x==='object'&&o.x.kind==='gear').slice(0,10);html=`<p><b>ÖRS · YÜKSELTME</b><br>Taş: ${state.upgradeStones} · Coin: ${state.coins}</p><button id="upgradeEquipped">⚔ ${state.weapon.name} +${wp} · ${Math.round(itemUpgradeChance(wp)*100)}% · ${wc.stones} taş / ${wc.coin} coin</button>`+gear.map(({x,i})=>{const c=upgradeCost(x.plus||0),r=rarityData[x.rarity||'common'];return `<button class="upgradeInv" data-i="${i}" style="border-color:${r.c}">${itemIcon(x)} ${x.name} +${x.plus||0} · ${Math.round(itemUpgradeChance(x.plus||0)*100)}% · ${c.stones} taş / ${c.coin} coin</button>`}).join('')}else html='<p>Karakuyu Zindanı ve Kızıl Sınır portalları kapının iki yanında. Ücretsiz geçiş açık.</p>';ui.dialogBody.innerHTML=html;ui.dialog.classList.add('open');setTimeout(()=>{const r=$('#reward');if(r)r.onclick=()=>{state.xp+=500;state.coins+=250;state.kills=-999;$('#questText').textContent='Görev tamamlandı. Yeni görev zinciri hazırlanıyor.';ui.dialog.classList.remove('open');renderHud();message('Görev tamamlandı.')};const p=$('#buyPot');if(p)p.onclick=()=>{if(state.coins<50){message('Yeterli coin yok.');return}state.coins-=50;state.potions+=5;sfx('pot');saveProgress();renderHud();npcDialog(n);message('5 Can İksiri alındı.')};const st=$('#stash');if(st)st.onclick=()=>{state.loot=[];renderHud();message('Loot warehouse içine aktarıldı.')};const up=$('#upgradeWeapon');if(up)up.onclick=upgradeWeapon;const ue=$('#upgradeEquipped');if(ue)ue.onclick=upgradeEquippedWeapon;document.querySelectorAll('.upgradeInv').forEach(b=>b.onclick=()=>upgradeInventoryItem(+b.dataset.i));},0)}
function interact(entity){if(entity.role==='groundLoot'&&entity.loot){collectWorldLoot(entity.loot);return}if(entity.target){currentMap=entity.target;syncVisibility();return}if(entity.role)npcDialog(entity)}
function rayClick(e){if(state.dead)return;const rect=renderer.domElement.getBoundingClientRect();mouse.x=((e.clientX-rect.left)/rect.width)*2-1;mouse.y=-((e.clientY-rect.top)/rect.height)*2+1;ray.setFromCamera(mouse,camera);const hits=ray.intersectObjects(scene.children,true);let entity=null,ground=null;for(const h of hits){if(h.object.userData.entity){entity=h.object.userData.entity;break}if(h.object.userData.type==='ground'&&h.object.userData.map===currentMap)ground=h}if(entity){if(entity.kind==='loot'){const d=player.position.distanceTo(entity.mesh.position);if(d<2.7)collectWorldLoot(entity);else{pending={role:'groundLoot',loot:entity,mesh:entity.mesh};moveTarget=entity.mesh.position.clone()}}else if(entity.hp!==undefined){setTarget(entity);message(`Hedef seçildi: ${entity.name}`)}else{pending=entity;moveTarget=entity.mesh.position.clone()}}else if(ground){moveTarget=ground.point.clone();moveTarget.y=0;pending=null;state.auto=false}}
function dodge(){const now=performance.now();if(state.dead||now<state.dodgeUntil||now<state.hitStunUntil||state.stamina<35)return;if(pendingAttack)pendingAttack=null;state.auto=false;state.afk=false;state.stamina-=35;state.invulnUntil=now+330;state.dodgeUntil=now+420;setCombatState('dodge',state.dodgeUntil);const view=new THREE.Vector3(Math.sin(cameraYaw),0,-Math.cos(cameraYaw)),right=new THREE.Vector3(Math.cos(cameraYaw),0,Math.sin(cameraYaw)),d=new THREE.Vector3();if(keys.w)d.add(view);if(keys.s)d.sub(view);if(keys.d)d.add(right);if(keys.a)d.sub(right);if(Math.abs(virtualAxis.y)>.06)d.addScaledVector(view,-virtualAxis.y);if(Math.abs(virtualAxis.x)>.06)d.addScaledVector(right,virtualAxis.x);if(d.lengthSq()<.01)d.copy(view).multiplyScalar(-1);state.dodgeDir.copy(d.normalize());state.screenShake=.08;renderHud()}
renderer.domElement.addEventListener('contextmenu',e=>e.preventDefault());renderer.domElement.addEventListener('pointerdown',e=>{if(e.button===2){rotating=true;lastPX=e.clientX;lastPY=e.clientY;renderer.domElement.setPointerCapture?.(e.pointerId);return}if(e.pointerType==='touch'&&e.clientX>innerWidth*.52){touchCamera=true;lastPX=e.clientX;lastPY=e.clientY;renderer.domElement.setPointerCapture?.(e.pointerId)}});renderer.domElement.addEventListener('pointermove',e=>{if(rotating||touchCamera){const dx=e.clientX-lastPX,dy=e.clientY-lastPY;cameraYaw+=dx*.006;cameraPitch=Math.max(.12,Math.min(1.05,cameraPitch-dy*.004));lastPX=e.clientX;lastPY=e.clientY}});renderer.domElement.addEventListener('pointerup',e=>{if(rotating&&e.button===2){rotating=false;return}if(touchCamera){touchCamera=false;return}if(e.button===0||e.pointerType==='touch')rayClick(e)});renderer.domElement.addEventListener('wheel',e=>{cameraDist=Math.max(5,Math.min(15,cameraDist+Math.sign(e.deltaY)*.8))},{passive:true});
addEventListener('keydown',e=>{const k=e.key.toLowerCase();if(['w','a','s','d'].includes(k)){keys[k]=true;e.preventDefault()}if(k==='shift')keys.shift=true;if(k===' '||e.code==='Space'){dodge();e.preventDefault()}if(k==='z'){targetNearest();e.preventDefault()}if(k==='r'){toggleAuto();e.preventDefault()}if(k==='f'){toggleAfk();e.preventDefault()}if(k==='i'){toggleInventory();e.preventDefa