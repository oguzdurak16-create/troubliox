{
  "name": "troublio",
  "version": "1.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run typecheck && pnpm run validate:content && pnpm run audit:repo && pnpm run audit:similarity && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "audit:repo": "node scripts/audit-repository.mjs --strict",
    "audit:similarity": "node scripts/audit-content-similarity.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "indexnow:check": "node scripts/submit-indexnow.mjs --dry-run",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "22.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
